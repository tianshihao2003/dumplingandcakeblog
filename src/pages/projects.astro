---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 获取所有导航数据
const allEntries = await getCollection("daohang");

// 分类由「文件所在的文件夹」决定（不再写 frontmatter.category）
// 迁移前的老数据都在 daohang 根目录，没有目录时归入「未分类」

/**
 * 分类元数据：显示名 / 排序 / 图标。
 * key 用文件夹名，比较时统一按「小写 + 空格转连字符」归一化：
 * Astro 生成 entry id 时会把大写转小写、空格转连字符（`AI 工具` → `ai-工具`），
 * 所以映射表不能只按原样匹配。
 */
const CATEGORY_META: Record<string, { display: string; order: number; icon: string }> = {
	"未分类": { display: "未分类", order: 13, icon: "material-symbols:link" },
	"我的网站": { display: "我的网站", order: 0, icon: "material-symbols:person" },
	"常用网站": { display: "常用网站", order: 1, icon: "material-symbols:star" },
	"在用网站": { display: "在用网站", order: 1.5, icon: "material-symbols:star" },
	"资源网站": { display: "资源网站", order: 2, icon: "material-symbols:folder" },
	"工具网站": { display: "工具网站", order: 3, icon: "material-symbols:handyman" },
	"学习网站": { display: "学习网站", order: 5, icon: "material-symbols:school" },
	"文档": { display: "文档", order: 6, icon: "material-symbols:description" },
	"设计资源": { display: "设计资源", order: 7, icon: "material-symbols:palette" },
	"实用项目": { display: "实用项目", order: 8, icon: "material-symbols:deployed-code" },
	"API": { display: "API", order: 9, icon: "material-symbols:api" },
	"AI 工具": { display: "AI 工具", order: 10, icon: "material-symbols:smart-toy" },
	"影视网站": { display: "影视网站", order: 11, icon: "material-symbols:movie" },
	"其他网站": { display: "其他网站", order: 12, icon: "material-symbols:link" },
};

/** 归一化：小写 + 空格转连字符，与 Astro 的 entry id 规则对齐 */
const normalizeCatKey = (name: string) => name.toLowerCase().replace(/\s+/g, "-");

/** 从 entry id 取分类：id 形如「我的网站/xxx.md」或「xxx.md」 */
function getFolderCategory(id: string): string {
	const normalized = id.replace(/\\/g, "/").replace(/\.(md|mdx)$/i, "");
	const slash = normalized.lastIndexOf("/");
	return slash < 0 ? "未分类" : normalized.slice(0, slash);
}

function getCategoryMeta(folder: string) {
	const key = normalizeCatKey(folder);
	for (const [k, v] of Object.entries(CATEGORY_META)) {
		if (normalizeCatKey(k) === key) return v;
	}
	return { display: folder, order: 99, icon: "material-symbols:link" };
}

// 按分类分组
const categoryMap = new Map<string, { items: typeof allEntries; display: string; order: number; icon: string }>();

allEntries.forEach((entry) => {
	const folder = getFolderCategory(entry.id);
	const meta = getCategoryMeta(folder);
	if (!categoryMap.has(folder)) {
		categoryMap.set(folder, { items: [], display: meta.display, order: meta.order, icon: meta.icon });
	}
	categoryMap.get(folder)?.items.push(entry);
});

// 分类排序
const sortedCategories = [...categoryMap.entries()]
	.sort(([, a], [, b]) => a.order - b.order)
	.map(([folder]) => folder);

const sortedData = new Map(
	[...categoryMap.entries()]
		.sort(([, a], [, b]) => a.order - b.order)
		.map(([folder, { items }]) => [
			folder,
			[...items].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)),
		]),
);

const getCategoryIcon = (cat: string) => getCategoryMeta(cat).icon;
const getCategoryDisplay = (cat: string) => getCategoryMeta(cat).display;

// 计算每个分类的数量
const categoryCounts: Record<string, number> = {};
for (const [cat, items] of sortedData) {
	categoryCounts[cat] = items.length;
}

// 所有启用的网站（扁平列表）
const allSites = sortedCategories.flatMap((cat) => sortedData.get(cat) ?? []);
---

<MainGridLayout title="网站导航" description="收录个人网站、常用工具和收藏网站">

  <script slot="head" is:inline>
    (function() {
      function initToolsTabs() {
        var tabNav = document.querySelector('[data-tools-tab-nav]');
        var tabButtons = document.querySelectorAll('[data-tools-tab]');
        var sections = document.querySelectorAll('[data-tools-section]');
        var indicator = document.querySelector('[data-tools-tab-indicator]');
        if (!tabNav || !tabButtons.length || !indicator) return;

        function updateIndicator(targetBtn) {
          if (!indicator || !targetBtn) return;
          indicator.style.left = targetBtn.offsetLeft + 'px';
          indicator.style.top = targetBtn.offsetTop + 'px';
          indicator.style.width = targetBtn.offsetWidth + 'px';
          indicator.style.height = targetBtn.offsetHeight + 'px';
          indicator.style.opacity = '1';
        }

        function activateTab(targetTab) {
          if (!targetTab) return;
          var targetButton = Array.from(tabButtons).find(function(btn) {
            return btn.dataset.toolsTab === targetTab;
          });
          if (!targetButton) return;

          // 切换按钮激活状态
          tabButtons.forEach(function(btn) {
            btn.classList.remove('tools-tab-btn-active');
            btn.classList.add('tools-tab-btn-inactive');
            btn.disabled = false;
          });
          targetButton.classList.remove('tools-tab-btn-inactive');
          targetButton.classList.add('tools-tab-btn-active');
          targetButton.disabled = true;

          // 更新指示器
          requestAnimationFrame(function() { updateIndicator(targetButton); });

          // 切换内容区域并重置卡片动画
          sections.forEach(function(section) {
            if (section.dataset.toolsSection === targetTab) {
              section.classList.remove('hidden');
              var cards = section.querySelectorAll('.tools-card');
              cards.forEach(function(card) {
                card.style.animation = 'none';
                card.offsetHeight;
                card.style.animation = '';
              });
            } else {
              section.classList.add('hidden');
            }
          });

          var nextHash = '#tools-' + encodeURIComponent(targetTab);
          if (window.location.hash !== nextHash) {
            window.history.replaceState(null, '', nextHash);
          }
        }

        // 绑定点击事件
        tabButtons.forEach(function(button) {
          button.addEventListener('click', function() {
            var targetTab = button.dataset.toolsTab;
            if (targetTab) activateTab(targetTab);
          });
        });

        // 从 hash 恢复 Tab
        function getTabFromHash() {
          var hash = window.location.hash.replace(/^#tools-/, '');
          if (!hash) return '';
          try { return decodeURIComponent(hash); } catch(e) { return ''; }
        }

        var initialTab = getTabFromHash();
        if (initialTab) {
          activateTab(initialTab);
        } else {
          var activeBtn = tabNav.querySelector('.tools-tab-btn-active');
          if (activeBtn) {
            requestAnimationFrame(function() { updateIndicator(activeBtn); });
          }
        }

        window.addEventListener('hashchange', function() {
          var tabFromHash = getTabFromHash();
          if (tabFromHash) activateTab(tabFromHash);
        });

        window.addEventListener('resize', function() {
          var activeBtn = tabNav.querySelector('.tools-tab-btn-active');
          if (activeBtn) updateIndicator(activeBtn);
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initToolsTabs);
      } else {
        initToolsTabs();
      }
      document.addEventListener("astro:page-load", initToolsTabs);
      document.addEventListener("astro:after-swap", initToolsTabs);
      document.addEventListener("swup:content:replaced", initToolsTabs);
    })();
  </script>

  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <!-- 页面标题 -->
      <div class="mb-6">
        <div class="flex items-center gap-3 mb-3">
          <Icon name="material-symbols:bookmark" class="text-[1.875rem] text-neutral-900 dark:text-neutral-100" />
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            网站导航
          </div>
        </div>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          收录个人网站、常用工具和收藏网站
        </p>
      </div>

      <!-- Tab 分类导航（椭圆胶囊 + 换行） -->
      {allSites.length > 0 && sortedCategories.length > 1 && (
        <div class="tools-tab-wrapper">
          <div class="tools-tab-pill" data-tools-tab-nav>
            <div class="tools-tab-indicator" data-tools-tab-indicator></div>
            <button data-tools-tab="all" class="tools-tab-btn tools-tab-btn-active">
              全部
              <span class="tools-tab-badge">{allSites.length}</span>
            </button>
            {sortedCategories.map((cat) => (
              <button data-tools-tab={cat} class="tools-tab-btn tools-tab-btn-inactive">
                {getCategoryDisplay(cat)}
                <span class="tools-tab-badge">{categoryCounts[cat]}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- 工具卡片内容 -->
      {allSites.length > 0 ? (
        <div>
          <!-- 全部：按分类分组显示 -->
          <div data-tools-section="all">
            {sortedCategories.map((cat) => {
              const catSites = sortedData.get(cat)!;
              if (catSites.length === 0) return null;
              return (
                <div class="tools-category-group mt-8 first:mt-0">
                  <div class="flex items-center gap-3 mb-5">
                    <div class="flex items-center gap-2">
                      <Icon name={getCategoryIcon(cat)} class="text-lg text-neutral-900 dark:text-neutral-100" />
                      <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">{getCategoryDisplay(cat)}</span>
                    </div>
                    <span class="text-xs text-neutral-400 dark:text-neutral-500">{catSites.length}</span>
                    <div class="flex-1 h-px bg-neutral-300 dark:bg-neutral-700" />
                  </div>
                  <div class="tools-card-grid">
                    {catSites.map((site, index) => (
                      <a
                        href={site.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="tools-card group"
                        data-category={cat}
                        style={`animation-delay: ${index * 60}ms`}
                      >
                        <div class="flex items-center gap-2 mb-3">
                          {site.data.icon ? (
                            site.data.icon.startsWith('http') ? (
                              <img src={site.data.icon} alt={site.data.name} class="w-5 h-5 rounded object-contain shrink-0" />
                            ) : site.data.icon.startsWith('/') ? (
                              <img src={site.data.icon} alt={site.data.name} class="w-5 h-5 rounded object-contain shrink-0" />
                            ) : (
                              <Icon name={site.data.icon} class="text-xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                            )
                          ) : site.data.image ? (
                            <img src={site.data.image} alt={site.data.name} class="w-5 h-5 rounded object-contain shrink-0" />
                          ) : (
                            <Icon name="material-symbols:language" class="text-xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                          )}
                          <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100 group-hover:translate-x-0.5 transition-transform duration-300 truncate">
                            {site.data.name}
                          </h3>
                        </div>
                        <p class="tools-card-desc">{site.data.description}</p>
                        <div class="tools-card-footer">
                          <span class="text-[0.6875rem] text-neutral-400 dark:text-neutral-500 truncate">
                            {(() => {
                              try { return new URL(site.data.url).hostname; } catch { return site.data.url; }
                            })()}
                          </span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

          <!-- 各分类独立 Tab 内容 -->
          {sortedCategories.map((cat) => {
            const catSites = sortedData.get(cat)!;
            if (catSites.length === 0) return null;
            return (
              <div data-tools-section={cat} class="hidden">
                <div class="tools-card-grid">
                  {catSites.map((site, index) => (
                    <a
                      href={site.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="tools-card group"
                      data-category={cat}
                      style={`animation-delay: ${index * 60}ms`}
                    >
                      <div class="flex items-center gap-2 mb-3">
                        {site.data.icon ? (
                          site.data.icon.startsWith('http') ? (
                            <img src={site.data.icon} alt={site.data.name} class="w-5 h-5 rounded object-contain shrink-0" />
                          ) : site.data.icon.startsWith('/') ? (
                            <img src={site.data.icon} alt={site.data.name} class="w-5 h-5 rounded object-contain shrink-0" />
                          ) : (
                            <Icon name={site.data.icon} class="text-xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                          )
                        ) : site.data.image ? (
                          <img src={site.data.image} alt={site.data.name} class="w-5 h-5 rounded object-contain shrink-0" />
                        ) : (
                          <Icon name="material-symbols:language" class="text-xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                        )}
                        <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100 group-hover:translate-x-0.5 transition-transform duration-300 truncate">
                          {site.data.name}
                        </h3>
                      </div>
                      <p class="tools-card-desc">{site.data.description}</p>
                      <div class="tools-card-footer">
                        <span class="text-[0.6875rem] text-neutral-400 dark:text-neutral-500 truncate">
                          {(() => {
                            try { return new URL(site.data.url).hostname; } catch { return site.data.url; }
                          })()}
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <Icon name="material-symbols:bookmark-outline" class="text-5xl text-neutral-300 dark:text-neutral-600 mb-4" />
          <p class="text-neutral-500 dark:text-neutral-400">暂无收录的网站</p>
        </div>
      )}
    </div>
  </div>

</MainGridLayout>

<style>
  /* ===== Tab 外层 ===== */
  .tools-tab-wrapper {
    margin-bottom: 1.5rem;
  }

  /* 胶囊容器（换行） */
  .tools-tab-pill {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.375rem;
    border-radius: 1rem;
    border: 1px solid oklch(0.25 0 0);
  }
  :root.dark .tools-tab-pill {
    border-color: oklch(0.85 0 0);
  }

  /* 滑动指示条（填充胶囊背景） */
  .tools-tab-indicator {
    position: absolute;
    border-radius: 9999px;
    background: #000;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                top 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }
  :root.dark .tools-tab-indicator {
    background: #fff;
  }

  /* Tab 按钮 */
  .tools-tab-btn {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border: none;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    background: transparent;
    transition: color 0.2s;
    flex-shrink: 0;
    font-family: inherit;
  }

  /* 激活态：指示条覆盖时白色文字 */
  .tools-tab-btn-active {
    color: #fff;
    cursor: default;
  }
  :root.dark .tools-tab-btn-active {
    color: #000;
  }

  /* 未激活态：黑色文字 */
  .tools-tab-btn-inactive {
    color: #000;
  }
  .tools-tab-btn-inactive:hover {
    opacity: 0.7;
  }
  :root.dark .tools-tab-btn-inactive {
    color: #fff;
  }

  /* 数量徽章 */
  .tools-tab-badge {
    font-size: 0.65rem;
    padding: 0.0625rem 0.375rem;
    border-radius: 9999px;
    background: oklch(0.92 0 0);
    color: oklch(0.35 0 0);
    line-height: 1.4;
  }
  :root.dark .tools-tab-badge {
    background: oklch(0.25 0 0);
    color: oklch(0.65 0 0);
  }

  /* 激活态徽章反转 */
  .tools-tab-btn-active .tools-tab-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
  }
  :root.dark .tools-tab-btn-active .tools-tab-badge {
    background: rgba(0, 0, 0, 0.2);
    color: #000;
  }

  /* 分组间距（"全部" Tab） */
  .tools-category-group + .tools-category-group {
    margin-top: 2rem;
  }

  /* 卡片网格 */
  .tools-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 1024px) {
    .tools-card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .tools-card-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
  @media (max-width: 480px) {
    .tools-card-grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 0.75rem;
    }
  }

  /* 卡片样式 */
  .tools-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.125rem;
    border-radius: 0.75rem;
    border: 2px solid #000;
    background: transparent;
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    animation: toolsCardSlideIn 0.5s ease-out forwards;
    transition: border-color 300ms ease, box-shadow 300ms ease, transform 300ms ease, background-color 300ms ease;
  }
  :root.dark .tools-card {
    border-color: #fff;
    background: transparent;
  }
  .tools-card:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }
  :root.dark .tools-card:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 12px rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  /* 右上角跳转图标 */
  .tools-card-jump-icon {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    color: oklch(0.55 0 0);
    background: oklch(0.9 0 0);
    opacity: 0;
    transform: scale(0.8) translateY(-4px);
    transition: opacity 250ms cubic-bezier(0.4, 0, 0.2, 1), transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 2;
    pointer-events: none;
  }
  :root.dark .tools-card-jump-icon {
    color: oklch(0.6 0 0);
    background: oklch(0.2 0 0);
  }
  .tools-card:hover .tools-card-jump-icon {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* 描述文本：固定两行高度（短描述留白、长描述截断），保证同排卡片高度一致 */
  .tools-card-desc {
    margin: 0 0 0.625rem 0;
    font-size: 0.75rem;
    font-weight: 400;
    color: oklch(0.45 0 0);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    min-height: 3.2em;
    max-height: 3.2em;
  }
  :root.dark .tools-card-desc {
    color: oklch(0.6 0 0);
  }

  /* 底部域名 */
  .tools-card-footer {
    display: flex;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid oklch(0.9 0 0);
    margin-top: auto;
  }
  :root.dark .tools-card-footer {
    border-color: oklch(0.2 0 0);
  }

  @keyframes toolsCardSlideIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
