---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import NotebookCommentModal from "@/components/comment/NotebookCommentModal.svelte";
import ArchiveHeatmap from "@/components/widget/ArchiveHeatmap.astro";
import { profileConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "../../../styles/pages/notebooks.css";
import "../../../styles/components/post-hero.css";

export async function getStaticPaths() {
	const allEntries = await getCollection("notebooks");
	const paths: {
		params: { slug: string };
		props: {
			entry: CollectionEntry<"notebooks">;
			sortedEntries: CollectionEntry<"notebooks">[];
		};
	}[] = [];

	for (const entry of allEntries) {
		const normalizedId = entry.id.replace(/\\/g, "/");
		if (normalizedId === "readme" || normalizedId === "readme.md") continue;
		const isIndexFile =
			/\/(_index|_index\.md|_index\.json)?$/.test(normalizedId) &&
			(normalizedId.endsWith("_index") || normalizedId.includes("/_index."));
		const isNotebookRoot =
			normalizedId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
			normalizedId.match(/^([^/]+)\/_index$/);
		if (!isIndexFile || !isNotebookRoot) continue;

		const folderName = isNotebookRoot[1];
		const folderEntries = allEntries.filter((item) => {
			const itemId = item.id.replace(/\\/g, "/");
			return (
				itemId.startsWith(`${folderName}/`) &&
				!/^([^/]+)\/(_index|_index\.md|_index\.json)$/.test(itemId) &&
				itemId !== `${folderName}/_index` &&
				itemId !== `${folderName}/_index.md` &&
				itemId !== `${folderName}/_index.json`
			);
		});
		const sortedEntries = [...folderEntries].sort((a, b) => {
			const aT = a.data.date instanceof Date ? a.data.date.getTime() : 0;
			const bT = b.data.date instanceof Date ? b.data.date.getTime() : 0;
			return bT - aT;
		});

		paths.push({
			params: { slug: folderName },
			props: { entry, sortedEntries },
		});
	}
	return paths;
}

const { entry, sortedEntries } = Astro.props as {
	entry: CollectionEntry<"notebooks">;
	sortedEntries: CollectionEntry<"notebooks">[];
};

const normalizedEntryId = entry.id.replace(/\\/g, "/");
const isNotebookRootMatch =
	normalizedEntryId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
	normalizedEntryId.match(/^([^/]+)\/_index$/);
const folderName = isNotebookRootMatch
	? isNotebookRootMatch[1]
	: normalizedEntryId.split("/")[0];

// 所有笔记本列表（面包屑下拉）
const allNotebooks = await getCollection("notebooks");
const notebookList = allNotebooks
	.filter((e) => {
		const id = e.id.replace(/\\/g, "/");
		return (
			/\/(_index|_index\.md|_index\.json)$/.test(id) || /\/_index$/.test(id)
		);
	})
	.map((e) => {
		const m = e.id.replace(/\\/g, "/").match(/^([^/]+)\//);
		return { name: e.data.name || m?.[1] || "", folder: m?.[1] || "" };
	})
	.filter((n) => n.name);

// 热力图数据
const heatmapPosts = (sortedEntries || []).map((e) => ({
	id: e.id,
	data: {
		title: e.data.name || e.id,
		published: e.data.date instanceof Date ? e.data.date : new Date(0),
	},
}));

// 归一化图片字段：优先 images，兼容旧 image，支持 string|string[]
function normalizeImages(raw: string | string[] | undefined): string[] {
	if (!raw) return [];
	if (Array.isArray(raw)) {
		const out: string[] = [];
		for (const s of raw) {
			if (typeof s !== "string") continue;
			const t = s.trim();
			if (t) out.push(t);
		}
		return [...new Set(out)];
	}
	if (typeof raw === "string") {
		const t = raw.trim();
		if (!t) return [];
		return [
			...new Set(
				t
					.split(/[,;，；\n]/)
					.map((s) => s.trim())
					.filter(Boolean),
			),
		];
	}
	return [];
}

function getGridCols(count: number): number {
	if (count === 1) return 1;
	if (count === 2 || count === 4) return 2;
	return 3;
}

const gridMax = 9;
const noteAvatar = profileConfig.avatar || "/assets/ziyuan/tx.webp";

// 为每篇笔记预处理卡片所需数据（服务端直算，避免客户端再解析 markdown）
const CLAMP_CHARS = 12;
const noteCards = (sortedEntries || []).map((e) => {
	const id = e.id.replace(/\\/g, "/");
	const slug =
		id
			.split("/")
			.pop()
			?.replace(/\.(md|mdx)$/, "") || "note";
	const rawImages =
		(
			e.data as unknown as {
				images?: string | string[];
				image?: string | string[];
			}
		).images ??
		(
			e.data as unknown as {
				images?: string | string[];
				image?: string | string[];
			}
		).image ??
		"";
	const images = normalizeImages(rawImages as string | string[]);
	const rawBody = (e.body || "").trim();
	const textContent = rawBody || (e.data.summary as string) || "";
	const date = e.data.date instanceof Date ? e.data.date : null;
	const dateLabel = date ? `${date.getMonth() + 1}月${date.getDate()}日` : "";
	const dateFull = date ? date.toISOString().split("T")[0] : "";
	// 服务端预判是否需截断：按字符阈值近似超三行（避免首屏先展开再合上的闪烁，客户端仅精确校准）
	const needsClamp = textContent.length > CLAMP_CHARS * 3;
	const displayText = needsClamp
		? textContent.slice(0, CLAMP_CHARS)
		: textContent;
	return {
		entry: e,
		id,
		slug,
		anchorId: `note-${slug}`,
		name: e.data.name || slug,
		images,
		gridCols: getGridCols(images.length),
		textContent,
		displayText,
		needsClamp,
		date,
		dateLabel,
		dateFull,
		tags: (e.data.tags as string[]) || [],
	};
});
---

<MainGridLayout title="笔记本" description="成长日记、学习复盘、灵感随笔">
	<nav class="cb" id="nb-breadcrumb" aria-label="Breadcrumb" style="margin-bottom: 0.5rem;">
		<ol class="cb__list">
			<li class="cb__item">
				<a href="/life/notebooks/" class="cb__link">
					<span class="cb__icon"><Icon name="material-symbols:menu-book-outline" /></span>
					<span>笔记本</span>
				</a>
			</li>
			<li class="cb__item">
				<span class="cb__sep" aria-hidden="true">›</span>
				<span class="cb__dropdown" data-nb-dropdown data-current={folderName}>
					<button type="button" class="cb__dropdown-trigger" aria-haspopup="menu" aria-expanded="false" data-nb-dropdown-trigger>
						<span class="cb__dropdown-label" data-nb-dropdown-label>{entry.data.name || "笔记本"}</span>
						<span class="cb__dropdown-arrow" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M12 14.975q-.2 0-.375-.062T11.3 14.7l-4.6-4.6q-.275-.275-.275-.7t.275-.7q.275-.275.7-.275t.7.275L12 12.55l4.125-4.125q.275-.275.7-.275t.7.275q.275.275.275.7t-.275.7l-4.6 4.6q-.15.15-.325.213T12 14.975Z"/></svg>
						</span>
					</button>
					<span class="cb__dropdown-menu" role="menu" data-nb-dropdown-menu>
						{notebookList.map((nb) => (
							<a href={`/life/notebooks/${nb.folder}/`} class:list={["cb__dropdown-item", { "is-active": nb.folder === folderName }]} role="menuitem" data-nb-dropdown-item>
								<span>{nb.name}</span>
							</a>
						))}
					</span>
				</span>
			</li>
		</ol>
	</nav>

	<div class="flex w-full overflow-hidden relative min-h-32">
		<div data-pagefind-body class="card-base z-10 px-4 pt-0 pb-6 md:px-9 relative w-full">

			<ArchiveHeatmap posts={heatmapPosts} />

			{noteCards.length > 0 ? (
				<div class="nb-archive-feed" id="nb-archive-feed">
					{noteCards.map((card) => (
						<article class="nb-archive-card" id={card.anchorId} data-note-card>
							<div class="nb-archive-head">
								<div class="nb-archive-avatar">
									<img src={noteAvatar} alt="团子的笔记" class="nb-archive-avatar-img" loading="lazy" />
								</div>
								<div class="nb-archive-author">
									<span class="nb-archive-name">团子的笔记</span>
									{card.dateLabel && (
										<span class="nb-archive-time">
											<Icon name="material-symbols:schedule-outline" class="text-[0.75rem]" />
											{card.dateLabel}
											<span class="nb-archive-date-full">{card.dateFull}</span>
										</span>
									)}
								</div>
							</div>

							{card.textContent && (
								<div class="nb-archive-body">
									<div
										class:list={["nb-archive-content", { "is-clamped": card.needsClamp }]}
										data-note-content
										data-full-text={card.textContent}
										data-measured={card.needsClamp ? "1" : "0"}
									>{card.displayText}</div>
									<button
										type="button"
										class="nb-archive-expand-btn"
										aria-expanded="false"
										data-note-expand
										aria-label="展开全文"
										style={card.needsClamp ? "" : "display:none"}
									>
										<span class="nb-archive-expand-text">展开</span>
										<Icon name="material-symbols:expand-more-rounded" class="nb-archive-expand-icon" />
									</button>
								</div>
							)}

							{card.images.length > 0 && (
								<div class={`nb-archive-images image-cols-${card.gridCols}`}>
									{card.images.map((imgSrc, idx) => {
										const isHidden = idx >= gridMax;
										const isLastVisible = idx === gridMax - 1 && card.images.length > gridMax;
										return (
											<div class={`nb-image-item ${isHidden ? "hidden-image" : ""}`}>
												<img
													src={imgSrc}
													alt=""
													class="nb-image-img"
													loading="lazy"
													data-fancybox={`gallery-${folderName}-${card.slug}`}
													data-src={imgSrc}
												/>
												{isLastVisible && (
													<div class="more-overlay">
														<span class="more-text">+{card.images.length - gridMax + 1}</span>
													</div>
												)}
											</div>
										);
									})}
								</div>
							)}

							<div class="nb-archive-foot">
								<div class="nb-archive-tags">
									<span class="nb-archive-tag">#{card.name}</span>
								</div>
								<button
									type="button"
									class="nb-archive-comment comment-toggle-btn"
									aria-label="评论"
									title="评论此笔记"
									data-note-id={card.slug}
									data-note-published={card.dateFull || card.dateLabel}
									data-note-excerpt={card.textContent.slice(0, 80)}
								>
									<Icon name="material-symbols:chat-bubble-outline" class="text-sm" />
									<span>评论</span>
								</button>
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="nb-empty"><span class="nb-empty-icon">📝</span><p>还没有日记内容</p></div>
			)}
		</div>
	</div>

	<script is:inline>
	(function() {
		if (window.__nbDropdownInited) return;
		window.__nbDropdownInited = true;
		function closeDropdown(dd) { var trigger = dd.querySelector("[data-nb-dropdown-trigger]"); if (trigger) trigger.setAttribute("aria-expanded", "false"); dd.classList.remove("is-open"); }
		function openDropdown(dd) { var trigger = dd.querySelector("[data-nb-dropdown-trigger]"); var menu = dd.querySelector("[data-nb-dropdown-menu]"); if (trigger) trigger.setAttribute("aria-expanded", "true"); if (menu && trigger) { var rect = trigger.getBoundingClientRect(); menu.style.top = (rect.bottom + 6) + "px"; menu.style.left = rect.left + "px"; } dd.classList.add("is-open"); }
		document.addEventListener("click", function(e) {
			var t = e.target; if (!t) return;
			var trigger = t.closest && t.closest("[data-nb-dropdown-trigger]");
			var item = t.closest && t.closest("[data-nb-dropdown-item]");
			if (trigger) { e.preventDefault(); var dd = trigger.closest("[data-nb-dropdown]"); if (!dd) return; var isOpen = dd.classList.contains("is-open"); document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown); if (!isOpen) openDropdown(dd); return; }
			if (item) { e.preventDefault(); var href = item.getAttribute("href") || ""; document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown); if (href) window.location.href = href; return; }
			document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown);
		});
	})();
	</script>

	<NotebookCommentModal client:load />

	<script is:inline>
	(function() {
		function bindNotebookCommentDelegate(){
			if (window.__notebookCommentDelegateBound) return;
			window.__notebookCommentDelegateBound = true;
			document.addEventListener("click", function(e) {
				var btn = e.target.closest(".nb-archive-comment");
				if (!btn) return;
				var id = btn.getAttribute("data-note-id") || "";
				var published = btn.getAttribute("data-note-published") || "";
				var excerpt = btn.getAttribute("data-note-excerpt") || "";
				if (!id || !window.__notebookComment || !window.__notebookComment.open) return;
				e.preventDefault();
				window.__notebookComment.open(id, published, excerpt);
			});
		}
		bindNotebookCommentDelegate();
		document.addEventListener("swup:content:replaced", bindNotebookCommentDelegate);
		document.addEventListener("astro:page-load", bindNotebookCommentDelegate);
	})();
	</script>
	<script is:inline>
	(function() {
		if (window.__notebookArchiveBound) return;
		window.__notebookArchiveBound = true;

		var CLAMP_CHARS = 12;

		function setClampedText(content, fullText) {
			content.textContent = fullText.slice(0, CLAMP_CHARS);
		}

		function setFullText(content, fullText) {
			content.textContent = fullText;
		}

		function setupExpandButtons() {
			var cards = document.querySelectorAll("[data-note-card]");
			cards.forEach(function(card) {
				var content = card.querySelector("[data-note-content]");
				var btn = card.querySelector("[data-note-expand]");
				if (!content || !btn) return;
				// SSR 已按 12*3 预判；此处仅对预判为折叠的卡做一次精确校准：未超三行则回全文并隐藏按钮（已是全文的不再改动，避免无展开按钮的卡闪一下按钮）
				var fullText = content.getAttribute("data-full-text") || "";
				var isClamped = content.classList.contains("is-clamped");
				var isExpanded = content.classList.contains("is-expanded");
				if (isExpanded) return;
				if (!isClamped) {
					content.setAttribute("data-measured", "1");
					return;
				}
				if (fullText.length <= CLAMP_CHARS) {
					setFullText(content, fullText);
					content.classList.remove("is-clamped");
					btn.style.display = "none";
					content.setAttribute("data-measured", "1");
					return;
				}
				var lineH = parseFloat(getComputedStyle(content).lineHeight) || 0;
				if (!lineH) {
					var fs = parseFloat(getComputedStyle(content).fontSize) || 14;
					lineH = fs * 1.7;
				}
				// 以隐藏容器测全文三行，避免在可见区先展开再合上的闪烁
				var probe = document.createElement("div");
				probe.style.cssText = "position:absolute;visibility:hidden;pointer-events:none;left:-9999px;top:-9999px;width:" + content.clientWidth + "px;font:" + getComputedStyle(content).font + ";line-height:" + getComputedStyle(content).lineHeight + ";white-space:pre-wrap;word-break:break-word;";
				probe.textContent = fullText;
				document.body.appendChild(probe);
				var isOverflow = probe.scrollHeight > lineH * 3 + 1;
				document.body.removeChild(probe);
				if (!isOverflow) {
					setFullText(content, fullText);
					content.classList.remove("is-clamped");
					btn.style.display = "none";
					content.setAttribute("data-measured", "1");
					return;
				}
				setClampedText(content, fullText);
				content.classList.add("is-clamped");
				btn.style.display = "";
				content.setAttribute("data-measured", "1");
			});
		}

		function expandCard(card, content, btn) {
			var fullText = content.getAttribute("data-full-text") || "";
			setFullText(content, fullText);
			content.classList.remove("is-clamped");
			content.classList.add("is-expanded");
			btn.setAttribute("aria-expanded", "true");
			btn.style.display = "";
			var t = btn.querySelector(".nb-archive-expand-text");
			if (t) t.textContent = "收起";
			btn.classList.add("is-expanded");
		}

		function collapseCard(card, content, btn) {
			var fullText = content.getAttribute("data-full-text") || "";
			setClampedText(content, fullText);
			content.classList.remove("is-expanded");
			content.classList.add("is-clamped");
			btn.setAttribute("aria-expanded", "false");
			btn.style.display = "";
			var t2 = btn.querySelector(".nb-archive-expand-text");
			if (t2) t2.textContent = "展开";
			btn.classList.remove("is-expanded");
		}

		function handleHashScroll() {
			var hash = window.location.hash;
			if (!hash || hash.length < 2) return;
			var id = hash.slice(1);
			var target = document.getElementById(id);
			if (!target) return;
			target.classList.add("is-hash-target");
			setTimeout(function() { target.classList.remove("is-hash-target"); }, 1800);
			var rect = target.getBoundingClientRect();
			var top = window.scrollY + rect.top - 88;
			window.scrollTo({ top: top, behavior: "smooth" });
		}

		document.addEventListener("click", function(e) {
			var target = e.target;
			if (!target || !target.closest) return;
			var expandBtn = target.closest("[data-note-expand]");
			if (!expandBtn) return;
			var card = expandBtn.closest("[data-note-card]");
			if (!card) return;
			var content = card.querySelector("[data-note-content]");
			if (!content) return;
			var isExpanded = content.classList.contains("is-expanded");
			if (isExpanded) {
				collapseCard(card, content, expandBtn);
			} else {
				expandCard(card, content, expandBtn);
			}
		});

		function init() {
			requestAnimationFrame(function() {
				requestAnimationFrame(setupExpandButtons);
			});
			handleHashScroll();
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
		document.addEventListener("swup:content:replaced", init);
		document.addEventListener("astro:page-load", init);
		window.addEventListener("hashchange", handleHashScroll);
		window.addEventListener("resize", function() {
			requestAnimationFrame(setupExpandButtons);
		});
	})();
	</script>
	</MainGridLayout>

	<style>
	.nb-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3rem; background: var(--card-bg); border: 1.5px dashed var(--line-divider); border-radius: 1rem; text-align: center; }
	.nb-empty-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
	.nb-empty p { font-size: 0.875rem; color: var(--content-meta); margin: 0; }
</style>
