---
import { getCollection } from "astro:content";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import NotebookCommentModal from "@/components/comment/NotebookCommentModal.svelte";
import PageTitle from "@/components/common/PageTitle.astro";
import { profileConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "../../../styles/pages/notebooks.css";

const noteAvatar = profileConfig.avatar || "/assets/ziyuan/tx.webp";

// 预加载笔记本文件夹内的封面图片
const notebookCoverFiles = import.meta.glob<ImageMetadata>(
	"../../content/life/notebooks/**/*.{jpg,jpeg,png,webp,avif,gif,svg}",
	{ import: "default" },
);

const allEntries = await getCollection("notebooks");

const sortByDateDesc = <T extends Record<string, unknown>>(
	list: T[],
	field: keyof T,
) =>
	[...list].sort((a, b) => {
		const av = a[field];
		const bv = b[field];
		const aDate = av instanceof Date ? av.getTime() : 0;
		const bDate = bv instanceof Date ? bv.getTime() : 0;
		return bDate - aDate;
	});

const notebooks = allEntries
	.map((entry) => {
		const normalizedId = entry.id.replace(/\\/g, "/");
		if (normalizedId === "readme" || normalizedId === "readme.md") {
			return null;
		}
		const isNotebookRoot =
			normalizedId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
			normalizedId.match(/^([^/]+)\/_index$/);

		if (!isNotebookRoot) {
			return null;
		}

		const folderName = isNotebookRoot[1];

		const folderEntries = allEntries.filter((item) => {
			const itemId = item.id.replace(/\\/g, "/");
			const isIndexFile =
				itemId === `${folderName}/_index` ||
				itemId === `${folderName}/_index.md` ||
				itemId === `${folderName}/_index.json`;
			return itemId.startsWith(`${folderName}/`) && !isIndexFile;
		});

		const sortedEntries = sortByDateDesc(
			folderEntries.map((e) => e.data),
			"date",
		);
		const latestEntry = sortedEntries[0];

		return {
			id: entry.id,
			name: entry.data.name,
			cover: entry.data.cover,
			summary: entry.data.summary,
			entries: folderEntries.length,
			updatedAt:
				latestEntry?.date instanceof Date ? latestEntry.date : new Date(0),
			selfPath: `/life/notebooks/${folderName}/`,
			folderName,
		};
	})
	.filter(Boolean);

// 解析封面图：本地图片 → Astro ImageMetadata，URL → 直接使用
const notebooksWithCovers = await Promise.all(
	notebooks
		.filter((b) => b !== null)
		.map(async (book) => {
			let coverSrc: string | null = null;
			const rawCover = book.cover as string | undefined;
			if (rawCover) {
				if (
					rawCover.startsWith("http://") ||
					rawCover.startsWith("https://") ||
					rawCover.startsWith("/")
				) {
					coverSrc = rawCover;
				} else {
					const imageKey = path
						.normalize(
							path.join(
								"../../content/life/notebooks",
								book.folderName,
								rawCover,
							),
						)
						.replace(/\\/g, "/");
					const loader = notebookCoverFiles[imageKey];
					if (loader) {
						try {
							const img = await loader();
							coverSrc = img.src;
						} catch {
							coverSrc = null;
						}
					}
				}
			}
			return { ...book, coverSrc };
		}),
);

const sortedNotebooks = sortByDateDesc(notebooksWithCovers, "updatedAt");

// 统计数据
const totalNotebooks = sortedNotebooks.length;
const totalEntries = sortedNotebooks.reduce(
	(sum, b) => sum + (b?.entries || 0),
	0,
);
const latestUpdate =
	sortedNotebooks[0]?.updatedAt instanceof Date
		? sortedNotebooks[0].updatedAt
		: null;
const now = new Date();
const isToday =
	latestUpdate && latestUpdate.toDateString() === now.toDateString();
const isYesterday =
	latestUpdate &&
	new Date(now.getTime() - 86400000).toDateString() ===
		latestUpdate.toDateString();
const latestText = isToday
	? "今天"
	: isYesterday
		? "昨天"
		: latestUpdate
			? latestUpdate.toISOString().split("T")[0]
			: "暂无";

// 随机取一条笔记
const allEntriesRaw = await getCollection("notebooks");
const allNotes = allEntriesRaw.filter((e) => {
	const id = e.id.replace(/\\/g, "/");
	return (
		!id.match(/\/(_index|_index\.md|_index\.json)$/) &&
		id !== "readme" &&
		id !== "readme.md"
	);
});
const randomNote =
	allNotes.length > 0
		? allNotes[Math.floor(Math.random() * allNotes.length)]
		: null;
const randomNoteData = randomNote?.data;
const randomNoteFolder = randomNote
	? randomNote.id.replace(/\\/g, "/").split("/")[0]
	: "";
const randomNotebook = sortedNotebooks.find(
	(b) => b?.folderName === randomNoteFolder,
);

// 最新笔记（全部笔记本条目按时间倒序取前 10 条）
interface RecentNote {
	folder: string;
	notebookName: string;
	title: string;
	date: Date;
	href: string;
	content: string;
}
const recentNotes: RecentNote[] = allNotes
	.map((n) => {
		const id = n.id.replace(/\\/g, "/");
		const folder = id.split("/")[0];
		const slug =
			id
				.split("/")
				.pop()
				?.replace(/\.(md|mdx)$/, "") || "";
		const last = slug;
		const notebook =
			sortedNotebooks.find((b) => b?.folderName === folder) || null;
		const date = n.data.date instanceof Date ? n.data.date : null;
		// 笔记正文：去掉 markdown 标记后取纯文本（供卡片内容区显示）
		let content = (n.body || "")
			.replace(/[#*`>_\-[\]()!]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
		if (content.length > 120) content = `${content.slice(0, 120)}...`;
		return {
			folder,
			notebookName: notebook?.name || folder,
			title: n.data.name || last,
			date,
			href: `/life/notebooks/${folder}/#note-${slug}`,
			content: content || (n.data.summary as string) || "暂无内容",
		};
	})
	.filter((n): n is RecentNote => n.date !== null)
	.sort((a, b) => b.date.getTime() - a.date.getTime())
	.slice(0, 10);
---

<MainGridLayout title="笔记本" description="成长日记、学习复盘、灵感随笔">
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
		<div class="diary-page flex w-full flex-col gap-4" data-pagefind-body>
			<!-- 顶部：图标 + 标题 + 统计 -->
			<div class="diary-header">
				<div class="mb-6">
					<PageTitle
						title="笔记本"
						eyebrow="Notebooks"
						description="成长日记、学习复盘、灵感随笔"
					/>
				</div>

			<!-- 随机笔记（一行） -->
			{randomNoteData && (
				<a href={`/life/notebooks/${randomNoteFolder}/`} class="diary-random-note">
					<span class="diary-random-icon"><img src="/assets/images/emoji/1000023899.gif" alt="" width="18" height="18" /></span>
					<span class="diary-random-text">{randomNoteData.name || randomNoteData.summary || "未命名笔记"}</span>
					{randomNotebook && (
						<span class="diary-random-from">{randomNotebook.name}</span>
					)}
				</a>
			)}

			<!-- 统计栏 -->
			<div class="diary-stats">
				<span class="diary-stats-item">
					<Icon name="material-symbols:menu-book-outline" class="text-sm" />
					<strong>{totalNotebooks}</strong> 本
				</span>
				<span class="diary-stats-dot">·</span>
				<span class="diary-stats-item">
					<Icon name="material-symbols:edit-note" class="text-sm" />
					<strong>{totalEntries}</strong> 篇
				</span>
				<span class="diary-stats-dot">·</span>
				<span class="diary-stats-item">
					<Icon name="material-symbols:schedule" class="text-sm" />
					{latestText}
				</span>
			</div>
		</div>

		<!-- 笔记本列表 -->
		<section>
			{sortedNotebooks.length === 0 ? (
				<div class="diary-empty">
					<div class="text-6xl mb-4">📖</div>
					<h3 class="text-xl font-semibold mb-2 text-[var(--text-color)]">还没有日记本</h3>
					<p class="text-sm text-[var(--content-meta)]">开始记录你的第一篇日记吧！</p>
					<div class="mt-6 p-4 rounded-xl bg-[var(--btn-regular-bg)] text-left text-sm">
						<p class="text-[var(--text-color)] mb-2">创建步骤：</p>
						<ol class="text-[var(--content-meta)] space-y-1 list-decimal list-inside">
							<li>在 <code class="px-1 rounded bg-[var(--btn-regular-bg-hover)] font-mono">src/content/life/notebooks/</code> 下创建文件夹</li>
							<li>在文件夹内创建 <code class="px-1 rounded bg-[var(--btn-regular-bg-hover)] font-mono">_index.json</code> 文件</li>
							<li>在文件夹内创建 <code class="px-1 rounded bg-[var(--btn-regular-bg-hover)] font-mono">*.md</code> 文件作为日记条目</li>
						</ol>
					</div>
				</div>
			) : (
				<div class="diary-list">
					<div class="shelf-head">
						<span class="shelf-title">我的笔记本</span>
						<div class="shelf-nav">
							<button type="button" class="shelf-arrow" id="shelf-prev" aria-label="向左滚动" title="向左滚动">
								<Icon name="material-symbols:chevron-left-rounded" class="text-xl" />
							</button>
							<button type="button" class="shelf-arrow" id="shelf-next" aria-label="向右滚动" title="向右滚动">
								<Icon name="material-symbols:chevron-right-rounded" class="text-xl" />
							</button>
						</div>
					</div>
					<div class="shelf-scroller" id="notebook-shelf">
						{sortedNotebooks.map((book) => (
							<a
								href={book.selfPath}
								class="nb-book group"
								title={book.name || "未命名笔记本"}
							>
								<div class="nb-book-inner">
									{/* 书本主体：封面（上插画条 + 下白纸文字） */}
									<div class="nb-book-cover">
										{/* 上部插画条（封面图或封面色） */}
										<div class="nb-book-illustration">
											{book.coverSrc ? (
												<img src={book.coverSrc} alt={book.name || "笔记本封面"} class="nb-book-illustration-img" loading="lazy" />
											) : (
												<div class="nb-book-illustration-emoji">📔</div>
											)}
											<div class="nb-book-bind" aria-hidden="true"></div>
										</div>
										{/* 下部白色纸张文字区 */}
										<div class="nb-book-paper">
											<div class="nb-book-bind" aria-hidden="true"></div>
											<div class="nb-book-body">
												<h3 class="nb-book-name">{book.name || "未命名笔记本"}</h3>
												<p class="nb-book-summary">{book.summary || "暂无描述"}</p>
												<div class="nb-book-meta">
													<span class="nb-book-entries">{book.entries} 篇</span>
													<span class="nb-book-dot">·</span>
													<span class="nb-book-date">
														{book.updatedAt instanceof Date ? book.updatedAt.toISOString().split("T")[0] : "未更新"}
													</span>
												</div>
											</div>
										</div>
									</div>
									{/* 右侧纸张厚度 */}
									<div class="nb-book-pages" aria-hidden="true"></div>
									{/* 封底 */}
									<div class="nb-book-back" aria-hidden="true"></div>
								</div>
							</a>
						))}
					</div>
				</div>
			)}
		</section>

		<!-- 最新笔记区（卡片式） -->
		{recentNotes.length > 0 && (
			<section class="nb-recent">
				<div class="nb-recent-head">
					<Icon name="material-symbols:history-rounded" class="text-lg" />
					<span class="nb-recent-head-title">最新笔记</span>
					<span class="nb-recent-head-sub">最近更新，继续加油 ✨</span>
				</div>
				<div class="nb-recent-grid">
					{recentNotes.map((n) => (
							<article class="nb-note-card">
								<div class="nb-note-head">
									<div class="nb-note-avatar">
										<img src={noteAvatar} alt="团子的笔记" class="nb-note-avatar-img" loading="lazy" />
									</div>
									<div class="nb-note-author">
										<span class="nb-note-name">团子的笔记</span>
										<span class="nb-note-time">
											<Icon name="material-symbols:schedule-outline" class="text-[0.75rem]" />
											{n.date instanceof Date ? (n.date.getMonth() + 1) + "月" + n.date.getDate() + "日" : ""}
										</span>
									</div>
								</div>
								<a href={n.href} class="nb-note-body group">
									<span class="nb-note-content group-hover:text-(--primary)">{n.content}</span>
								</a>
								<div class="nb-note-foot">
									<div class="nb-note-tags">
										<span class="nb-note-tag">#{n.title}</span>
									</div>
									<button
										type="button"
										class="nb-note-comment comment-toggle-btn"
										aria-label="评论"
										title="评论此笔记"
										data-note-id={n.title}
										data-note-published={n.date instanceof Date ? n.date.toISOString().slice(0, 10) : ""}
										data-note-excerpt={n.content.slice(0, 80)}
									>
										<Icon name="material-symbols:chat-bubble-outline" class="text-sm" />
										<span>评论</span>
									</button>
								</div>
							</article>
					))}
				</div>
			</section>
			)}

		<!-- 评论区：复用动态同款弹窗（/moments/ 通道，支持引用/回复/图床/表情） -->
		<NotebookCommentModal client:load />

		<!-- 装饰页脚 -->
		<section class="text-center py-4">
			<p class="text-sm text-[var(--content-meta)] opacity-50">
				✨ 每一页都是成长的足迹
			</p>
		</section>

		<script is:inline>
			// 书架左右滚动 + 评论引用按钮：事件委托 + guard
			// 必须放在 Swup 容器内：从其它页面 SPA 导航进入时，容器外脚本不会执行
			(function () {
				if (window.__notebookShelfBound) return;
				window.__notebookShelfBound = true;

				document.addEventListener("click", function (e) {
					var target = e.target;

					// 弹窗评论：与归档页一致，走 window.__notebookComment.open
					var commentBtn = target.closest ? target.closest(".nb-note-comment") : null;
					if (commentBtn) {
						var nid = commentBtn.getAttribute("data-note-id") || "";
						var pub = commentBtn.getAttribute("data-note-published") || "";
						var exc = commentBtn.getAttribute("data-note-excerpt") || "";
						if (nid && window.__notebookComment && window.__notebookComment.open) {
							e.preventDefault();
							window.__notebookComment.open(nid, pub, exc);
							return;
						}
					}

					var prevBtn = target.closest ? target.closest("#shelf-prev") : null;
					var nextBtn = target.closest ? target.closest("#shelf-next") : null;
					if (!prevBtn && !nextBtn) return;

					var scroller = document.getElementById("notebook-shelf");
					if (!scroller) return;
					var book = scroller.querySelector(".nb-book");
					var step = book ? book.offsetWidth + 24 : 200; // 一本书宽 + 间距
					if (prevBtn) scroller.scrollBy({ left: -step, behavior: "smooth" });
					if (nextBtn) scroller.scrollBy({ left: step, behavior: "smooth" });
				});
			})();
		</script>
	</div>
	</div>
	</div>
	</MainGridLayout>

	<style>
	/* 样式已移至 src/styles/pages/notebooks.css（全局 CSS），避免 Swup 过渡时样式丢失 */
	</style>
