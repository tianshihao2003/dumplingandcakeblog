---
import CategoryFolders from "@components/widget/CategoryFolders.astro";
import CategoryRose from "@components/widget/CategoryRose.astro";
import TagGraph from "@components/widget/TagGraph.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import PageTitle from "@/components/common/PageTitle.astro";
import { getCategoryList, getCategoryTree } from "@/utils/content-utils";
import { getTagGraphData } from "@/utils/tag-graph-data";
import "../styles/pages/categories.css";

const categoryTree = await getCategoryTree();
const categoryList = await getCategoryList();
const categories = categoryList.map(({ name, count, url }) => ({
	name,
	count,
	url,
}));
const tagGraph = await getTagGraphData();
const title = "分类标签";
---

<MainGridLayout title={title}>
  <div class="categories-page card-base z-10 px-4 py-6 md:px-9 relative w-full" data-taxonomy-view-root>
    <div class="categories-page__header">
      <div class="mb-6">
        <PageTitle
          title="分类标签"
          eyebrow="Categories"
          description="按分类与标签浏览文章"
        />
      </div>

      <div
        class="categories-page__view-switch"
        role="tablist"
        aria-label="分类标签视图"
        data-taxonomy-view-switch
      >
        <button
          class="categories-page__view-button is-active"
          type="button"
          role="tab"
          id="taxonomy-view-folders"
          aria-controls="taxonomy-panel-folders"
          aria-selected="true"
          tabindex="0"
          data-taxonomy-view="folders"
        >
          <Icon name="material-symbols:folder-outline" aria-hidden="true" />
          <span>文件夹</span>
        </button>
        <button
          class="categories-page__view-button"
          type="button"
          role="tab"
          id="taxonomy-view-graph"
          aria-controls="taxonomy-panel-graph"
          aria-selected="false"
          tabindex="-1"
          data-taxonomy-view="graph"
        >
          <Icon name="material-symbols:bar-chart" aria-hidden="true" />
          <span>数据图</span>
        </button>
        <span class="categories-page__view-indicator" aria-hidden="true"></span>
      </div>
    </div>

    <section
      id="taxonomy-panel-folders"
      class="categories-page__panel"
      role="tabpanel"
      aria-labelledby="taxonomy-view-folders"
      data-taxonomy-panel="folders"
    >
      <CategoryFolders tree={categoryTree} />
    </section>

    <section
      id="taxonomy-panel-graph"
      class="categories-page__panel"
      role="tabpanel"
      aria-labelledby="taxonomy-view-graph"
      data-taxonomy-panel="graph"
      hidden
    >
      <CategoryRose categories={categories} />
      <div class="categories-page__divider"></div>
      <TagGraph graph={tagGraph} />
    </section>
  </div>
  <script is:inline>
  (function () {
    if (window.__taxonomyViewController) {
      window.__taxonomyViewController.init();
      return;
    }

    var indicatorFrame = 0;

    function resizeTaxonomyCharts() {
      requestAnimationFrame(() => {
        window.dispatchEvent(new Event("resize"));
      });
    }

    function updateTaxonomyIndicator(root) {
      var switcher = root.querySelector("[data-taxonomy-view-switch]");
      var activeButton = root.querySelector("[data-taxonomy-view].is-active");
      var indicator = switcher && switcher.querySelector(".categories-page__view-indicator");
      if (!switcher || !activeButton || !indicator) return;

      indicator.style.left = activeButton.offsetLeft + "px";
      indicator.style.width = activeButton.offsetWidth + "px";
      switcher.classList.add("is-ready");
    }

    function selectTaxonomyView(root, view) {
      const buttons = root.querySelectorAll("[data-taxonomy-view]");
      const panels = root.querySelectorAll("[data-taxonomy-panel]");

      for (const button of buttons) {
        const isActive = button.dataset.taxonomyView === view;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-selected", String(isActive));
        button.tabIndex = isActive ? 0 : -1;
      }

      for (const panel of panels) {
        panel.hidden = panel.dataset.taxonomyPanel !== view;
      }

      updateTaxonomyIndicator(root);
      if (view === "graph") resizeTaxonomyCharts();
    }

    function initTaxonomyView() {
      document.querySelectorAll("[data-taxonomy-view-root]").forEach((root) => {
        const activeButton = root.querySelector('[data-taxonomy-view][aria-selected="true"]')
          || root.querySelector("[data-taxonomy-view]");
        if (!activeButton) return;
        selectTaxonomyView(root, activeButton.dataset.taxonomyView || "folders");
      });
    }

    function handleTaxonomyClick(event) {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest("[data-taxonomy-view]");
      const root = button && button.closest("[data-taxonomy-view-root]");
      if (!button || !root) return;
      selectTaxonomyView(root, button.dataset.taxonomyView || "folders");
    }

    function handleTaxonomyKeydown(event) {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest("[data-taxonomy-view]");
      const root = button && button.closest("[data-taxonomy-view-root]");
      if (!button || !root) return;
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;

      const buttons = Array.from(root.querySelectorAll("[data-taxonomy-view]"));
      const currentIndex = buttons.indexOf(button);
      if (currentIndex < 0) return;

      event.preventDefault();
      let nextIndex = currentIndex;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = buttons.length - 1;
      if (event.key === "ArrowLeft") {
        nextIndex = (currentIndex - 1 + buttons.length) % buttons.length;
      }
      if (event.key === "ArrowRight") {
        nextIndex = (currentIndex + 1) % buttons.length;
      }

      const nextButton = buttons[nextIndex];
      if (nextButton) {
        nextButton.focus();
        selectTaxonomyView(root, nextButton.dataset.taxonomyView || "folders");
      }
    }

    function syncTaxonomyIndicators() {
      cancelAnimationFrame(indicatorFrame);
      indicatorFrame = requestAnimationFrame(() => {
        document.querySelectorAll("[data-taxonomy-view-root]").forEach(updateTaxonomyIndicator);
      });
    }

    window.__taxonomyViewController = { init: initTaxonomyView };
    document.addEventListener("click", handleTaxonomyClick);
    document.addEventListener("keydown", handleTaxonomyKeydown);
    document.addEventListener("astro:page-load", initTaxonomyView);
    window.addEventListener("resize", syncTaxonomyIndicators);

    initTaxonomyView();
  })();
  </script>
</MainGridLayout>
