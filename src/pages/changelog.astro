---
import { getCollection } from "astro:content";
import PageTitle from "@/components/common/PageTitle.astro";
import ChangelogLogs from "@/components/pages/ChangelogLogs.svelte";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { changelogEntriesFromCollection } from "@/utils/changelog";
import "../styles/pages/changelog-logs.css";

if (!siteConfig.pages.changelog) {
	return Astro.redirect("/404/");
}

const displayTitle = i18n(I18nKey.changelogTitle);
const displaySubtitle = i18n(I18nKey.changelogSubtitle);
const entries = changelogEntriesFromCollection(
	await getCollection("changelog"),
);
---

<MainGridLayout title={displayTitle} description={displaySubtitle}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="mb-6">
				<PageTitle
					title={displayTitle}
					eyebrow="Changelog"
					description={displaySubtitle}
				/>
			</div>

			<ChangelogLogs {entries} client:visible />
		</div>
	</div>
</MainGridLayout>
