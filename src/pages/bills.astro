---
import { getCollection } from "astro:content";
import { Solar } from "lunar-javascript";
import BalanceCard from "@/components/bills/BalanceCard.astro";
import BillCalendarCard from "@/components/bills/BillCalendarCard.astro";
import DailyTrendCard from "@/components/bills/DailyTrendCard.astro";
import ExpenseRankCard from "@/components/bills/ExpenseRankCard.astro";
import IncomeCategoryCard from "@/components/bills/IncomeCategoryCard.astro";
import MonthlyFlowCard from "@/components/bills/MonthlyFlowCard.astro";
import MonthlySummaryCard from "@/components/bills/MonthlySummaryCard.astro";
import YearlyFlowCard from "@/components/bills/YearlyFlowCard.astro";
import EncryptGate from "@/components/security/EncryptGate.astro";
import PasswordGate from "@/components/security/PasswordGate.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	categoryExpenseRank,
	categoryIncomeList,
	dailyIncomeExpense,
	getTodayMonthYearStats,
	groupBillsByDay,
	yearlyMonthlyFlow,
} from "@/utils/bill-adapter";
import { lunarLabel } from "@/utils/lunar";

const bills = await getCollection("bills");
const sorted = [...bills].sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const now = new Date();
// 固定用当前本地时间计算周期统计（图中为 2026-08-21，本月 08-01~08-31，本年 2026）
const period = getTodayMonthYearStats(sorted, now);
const year = now.getFullYear();
const month = now.getMonth() + 1;
const daily = dailyIncomeExpense(sorted, year, month);
const yearly = yearlyMonthlyFlow(sorted, year);
const expenseRank = categoryExpenseRank(sorted, year, month, 100);
const incomeList = categoryIncomeList(sorted, year, month, 100);
const monthIncome = period.month.income;
const monthExpense = period.month.expense;
const monthBalance = monthIncome - monthExpense;
// 结余卡：年统计口径（本年收入 − 本年支出）
const yearStats = period.year;
const yearBalance = yearStats.income - yearStats.expense;
// 月度流水：全部账单按月分桶，月内按天分组（降序），天按 time 降序
const WEEKDAYS = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
const nowMonth = `${year}-${String(month).padStart(2, "0")}`;
const monthsMap = new Map<
	string,
	{
		key: string;
		label: string;
		days: {
			key: string;
			label: string;
			income: number;
			expense: number;
			entries: {
				cat: string;
				desc: string;
				time: string;
				amount: number;
				type: string;
			}[];
		}[];
	}
>();
for (const [dayKey, entries] of groupBillsByDay(sorted)) {
	const monthKey = dayKey.slice(0, 7);
	let bucket = monthsMap.get(monthKey);
	if (!bucket) {
		const [y, m] = monthKey.split("-").map(Number);
		bucket = { key: monthKey, label: `${y}年${m}月`, days: [] };
		monthsMap.set(monthKey, bucket);
	}
	const d = entries[0].data.date;
	const dayEntries = [...entries]
		.sort((a, b) => (b.data.time || "").localeCompare(a.data.time || ""))
		.map((e) => ({
			cat: e.data.category || "其他",
			desc: e.data.description || e.data.title || "",
			time: e.data.time || "",
			amount: e.data.amount,
			type: e.data.type,
		}));
	bucket.days.push({
		key: dayKey,
		label: `${d.getMonth() + 1}月${d.getDate()}日(${WEEKDAYS[d.getDay()]})`,
		income: dayEntries
			.filter((e) => e.type === "income")
			.reduce((s, e) => s + e.amount, 0),
		expense: dayEntries
			.filter((e) => e.type === "expense")
			.reduce((s, e) => s + Math.abs(e.amount), 0),
		entries: dayEntries,
	});
}
if (!monthsMap.has(nowMonth)) {
	monthsMap.set(nowMonth, {
		key: nowMonth,
		label: `${year}年${month}月`,
		days: [],
	});
}
const flowMonths = [...monthsMap.values()];
// 账单日历：农历（初一显示月名）+ 每日收支，前后补齐整周
function calLunarLabel(y: number, m: number, d: number): string {
	try {
		const lunar = Solar.fromYmd(y, m, d).getLunar();
		if (lunar.getDayInChinese() === "初一") {
			return `${lunar.getMonthInChinese()}月`;
		}
	} catch {
		// 农历换算失败时回退普通标签
	}
	return lunarLabel(y, m, d);
}
const calendar = flowMonths.map((fm) => {
	const [y, m] = fm.key.split("-").map(Number);
	const totals = new Map(
		fm.days.map((d) => [d.key, { income: d.income, expense: d.expense }]),
	);
	const lead = new Date(y, m - 1, 1).getDay();
	const daysInMonth = new Date(y, m, 0).getDate();
	const cells: {
		day: number;
		lunar: string;
		inMonth: boolean;
		income: number;
		expense: number;
		dateKey: string;
	}[] = [];
	const push = (date: Date, inMonth: boolean) => {
		const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
		const t = inMonth ? totals.get(key) : undefined;
		cells.push({
			day: date.getDate(),
			lunar: calLunarLabel(
				date.getFullYear(),
				date.getMonth() + 1,
				date.getDate(),
			),
			inMonth,
			income: t?.income ?? 0,
			expense: t?.expense ?? 0,
			dateKey: key,
		});
	};
	for (let i = lead - 1; i >= 0; i--) push(new Date(y, m - 1, 1 - i), false);
	for (let d = 1; d <= daysInMonth; d++) push(new Date(y, m - 1, d), true);
	let tail = 1;
	while (cells.length % 7 !== 0) {
		push(new Date(y, m - 1, daysInMonth + tail), false);
		tail++;
	}
	const weeks: (typeof cells)[] = [];
	for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
	return { key: fm.key, label: fm.label, weeks };
});
// 支出排行总数
const expenseTotal = expenseRank.reduce((s, r) => s + r.amount, 0);
const expenseCount = expenseRank.reduce((s, r) => s + r.count, 0);
// 收入总数
const incomeTotalCount = incomeList.reduce((s, r) => s + r.count, 0);
const incomeTotalAmt = incomeList.reduce((s, r) => s + r.amount, 0);
---
<MainGridLayout title="账单" description="账单仪表盘">
  <EncryptGate gateId="bills">
    <div class="bills-page">
    <div class="bills-grid">
      <div class="bills-col">
        <div class="order-net"><BalanceCard income={yearStats.income} expense={yearStats.expense} balance={yearBalance} /></div>
      </div>
      <div class="bills-col">
        <div class="order-monthly"><MonthlySummaryCard income={monthIncome} expense={monthExpense} balance={monthBalance} /></div>
      </div>
    </div>
    <div class="order-today">
      <MonthlyFlowCard months={flowMonths} currentMonth={nowMonth} />
    </div>
    <div class="order-cal">
      <BillCalendarCard months={calendar} currentMonth={nowMonth} />
    </div>
    <div class="bills-grid">
      <div class="bills-col">
        <div class="order-daily"><DailyTrendCard year={year} month={month} data={daily} /></div>
        <div class="order-income"><IncomeCategoryCard data={incomeList} totalCount={incomeTotalCount} totalIncome={incomeTotalAmt} /></div>
      </div>
      <div class="bills-col">
        <div class="order-yearly"><YearlyFlowCard year={year} data={yearly} /></div>
        <div class="order-expense"><ExpenseRankCard data={expenseRank} totalCount={expenseCount} totalExpense={expenseTotal} /></div>
      </div>
    </div>
    <div class="bills-footer">
      <button class="bills-custom-btn" type="button">+ 自定义首页</button>
    </div>
  </div>
  </EncryptGate>
  <PasswordGate client:load gateId="bills" />
</MainGridLayout>

<style>
@reference "../styles/main.css";
.bills-page{ display:flex; flex-direction:column; gap:0.9rem; padding:0.6rem 0 1.2rem; }
.bills-grid{ display:grid; grid-template-columns:1fr 1fr; gap:0.9rem; align-items:start; }
/* 整体等比缩小：各卡片已按 0.9 比例缩减（padding/字号），此处再做容器级微缩 */
.bills-col{ display:flex; flex-direction:column; gap:0.9rem; }
.bills-footer{ display:flex; justify-content:center; padding-top:0.6rem; }
.bills-custom-btn{ padding:0.45rem 0.9rem; border:1px solid oklch(0 0 0 / 0.12); border-radius:0.5rem; background:#fff; font-size:0.72rem; color:var(--guestbook-muted); cursor:pointer; }
:root.dark .bills-custom-btn{ background: oklch(0.16 0 0 / 0.86); border-color: oklch(1 0 0 / 0.12); color:var(--guestbook-muted); }
@media(max-width:900px){
  .bills-grid{ grid-template-columns:1fr; }
  .bills-col{ display:contents; }
}
/* 中间放不下时等比再缩一点 */
@media(max-width:1200px){
  .bills-page{ zoom:0.92; }
}
@media(max-width:1024px){
  .bills-page{ zoom:0.88; }
}
</style>
