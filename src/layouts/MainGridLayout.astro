---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import MobileDock from "@components/layout/MobileDock.astro";
import Navbar from "@components/layout/Navbar.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import SideBar from "@components/layout/SideBar.astro";
import UnifiedDock from "@components/layout/UnifiedDock.astro";
import SidebarTOC from "@components/widget/SidebarTOC.astro";
import type { MarkdownHeading } from "astro";
import MobileMenuSheet from "@/components/layout/MobileMenuSheet.astro";
import {
	commentConfig,
	live2dModelConfig,
	navBarConfig,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { isHomePage } from "@/utils/layout-utils";
import { getSidebarPageType, type SidebarPageType } from "@/utils/page-type";
import {
	generateGridClasses,
	generateMainContentClasses,
	generateRightSidebarClasses,
	generateSidebarClasses,
	getResponsiveSidebarConfig,
	type ResponsiveSidebarConfig,
} from "@/utils/responsive-utils";
import Layout from "./Layout.astro";

import "@/styles/features/markdown.css";
import "@/styles/vendor/expressive-code.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	prevSlug?: string;
	prevTitle?: string;
	nextSlug?: string;
	nextTitle?: string;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
} = Astro.props;

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 检查是否在文章详情页
const isPostPage = !!postSlug;

// 不显示左右侧栏的页面：
// - 站长指定的「内容区放宽」页面（2026-09-22）：文章列表 /posts/、导航站 /projects/、
//   归档 /archive/、说说 /moments/、留言板 /guestbook/、更新日志 /changelog/、友链 /friends/
// - 文章详情页（2026-09-29）：右侧栏的位置要留给固定在正文右侧的文章目录浮层
//   （对齐参考博客的布局），所以文章页不再渲染左右侧栏组件。
// 判定复用统一的页面类型分类器（与侧栏组件的 showOnPages / hideOnPages 同一套规则）。
// 标记写到 #content-wrapper 上（它在 Swup 容器内，导航时会随内容替换），
// 这样纯 CSS 的 :has() 就能跟着页面切换自动生效，不需要 JS 参与。
const NO_SIDEBAR_PAGE_TYPES: SidebarPageType[] = [
	"post",
	"posts-list",
	"projects",
	"archive",
	"moments",
	"guestbook",
	"changelog",
	"friends",
	// 2026-09-30：影视与游戏页改成「左栏筛选 + 卡片网格」，左右栏小组件全部去掉
	"movies-games",
	// 2026-09-30：相册页变成一整面照片墙，左右小组件全去掉
	"album-list",
];
// data-no-sidebar 的值写成**具体页面类型**，这样 CSS 里能按页面单独设内容宽度
// （站长要逐页调整左右留白，共用一条规则会互相牵连）
const currentPageType = getSidebarPageType(Astro.url.pathname);
const noSidebarPageType = NO_SIDEBAR_PAGE_TYPES.includes(currentPageType)
	? currentPageType
	: undefined;

// banner 启用时用 35vh 偏移，否则用 5.5rem
const finalMainPanelTop = "5.5rem";

// 获取响应式侧边栏配置
const sidebarConfig = getResponsiveSidebarConfig();

// 在文章页面且启用了showBothSidebarsOnPostPage时，确保对侧组件参与网格计算
const shouldShowBothSidebarsOnPostPage: boolean =
	isPostPage &&
	sidebarLayoutConfig.position !== "both" &&
	!!sidebarLayoutConfig.showBothSidebarsOnPostPage;

// position为left时，对侧为右侧；position为right时，对侧为左侧
const shouldAddRightSidebar: boolean =
	shouldShowBothSidebarsOnPostPage && sidebarLayoutConfig.position === "left";
const shouldAddLeftSidebar: boolean =
	shouldShowBothSidebarsOnPostPage && sidebarLayoutConfig.position === "right";

const effectiveIsBothSidebars: boolean =
	sidebarConfig.isBothSidebars || shouldShowBothSidebarsOnPostPage;
const effectiveHasRightComponents: boolean =
	sidebarConfig.hasRightComponents ||
	(shouldAddRightSidebar &&
		sidebarLayoutConfig.rightComponents.some((comp) => comp.enable));
const effectiveHasLeftComponents: boolean =
	sidebarConfig.hasLeftComponents ||
	(shouldAddLeftSidebar &&
		sidebarLayoutConfig.leftComponents.some((comp) => comp.enable));

// 使用effective值重新生成网格类
// 当position为right且文章页临时显示左侧栏时，tabletSidebar应为right（保持显示主侧栏）
const effectiveTabletSidebar = shouldAddLeftSidebar
	? ("right" as const)
	: sidebarConfig.tabletSidebar;

const updatedGridConfig: ResponsiveSidebarConfig = {
	...sidebarConfig,
	isBothSidebars: effectiveIsBothSidebars,
	hasLeftComponents: effectiveHasLeftComponents,
	hasRightComponents: effectiveHasRightComponents,
	tabletSidebar: effectiveTabletSidebar,
};

const { gridCols: baseGridCols } = generateGridClasses(updatedGridConfig);
const sidebarClass = generateSidebarClasses(updatedGridConfig);
const rightSidebarClass =
	effectiveIsBothSidebars || sidebarLayoutConfig.position === "right"
		? generateRightSidebarClasses(updatedGridConfig)
		: "";
const mainContentClass = generateMainContentClasses(updatedGridConfig);
const staticBarClass = mainContentClass.replace("transition-main", "").trim();

// grid-class-carrier 始终存储非首页的网格类，供 JS 恢复用
const gridCols = baseGridCols;

const footerClass = ["footer", "col-span-1", "onload-animation"];

if (
	updatedGridConfig.isBothSidebars &&
	updatedGridConfig.hasLeftComponents &&
	updatedGridConfig.hasRightComponents
) {
	// 双侧栏：平板端跨2列，桌面端在中间列
	footerClass.push("md:col-span-2 xl:col-start-2 xl:col-span-1");
} else if (
	updatedGridConfig.hasLeftComponents &&
	!updatedGridConfig.hasRightComponents
) {
	footerClass.push("md:col-span-2 xl:col-start-2 xl:col-span-1");
} else if (
	!updatedGridConfig.hasLeftComponents &&
	updatedGridConfig.hasRightComponents
) {
	// 仅右侧栏：平板端跨2列，内容在第1列
	footerClass.push("md:col-span-2 md:col-start-1 xl:col-start-1 xl:col-span-1");
} else {
	footerClass.push("xl:col-start-1 xl:col-span-1");
}

const footerClassName = footerClass.join(" ");

const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const navLinks = navBarConfig.links.map((item: NavBarLink | LinkPreset) => {
	if (typeof item === "number") return LinkPresets[item];
	return item;
});
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug}>


<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative mx-auto" style="position: sticky; top: 0;">
  <div id="navbar-wrapper" class="pointer-events-auto bg-transparent" data-full-width={String(navbarWidthFull)}>
      <Navbar></Navbar>
  </div>
</div>

<NavMenuPanel links={navLinks} />


<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none no-banner-layout" style={`top: ${isHomePageCheck ? '0' : finalMainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class:list={["relative", "max-w-(--page-width)", "mx-auto", "pointer-events-auto", { "home-main-grid-wrapper": isHomePageCheck }]}>
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto px-2 md:px-4 ${!sidebarConfig.mobileShowSidebar ? 'mobile-no-sidebar' : ''} ${isPostPage ? 'gap-0 is-post-layout' : 'gap-4'}`}
          data-sidebar-position={sidebarLayoutConfig.position}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
          data-show-both-sidebars-on-post={sidebarLayoutConfig.showBothSidebarsOnPostPage ? "true" : "false"}
        >

            {/* 渲染左侧边栏 - CSS .lg\:is-home 控制首页隐藏 */}
            {sidebarLayoutConfig.position !== "right" ? (
                <>
                    <div id="left-sidebar-wrapper" class="contents" style="contain: layout style paint;">
                        {effectiveHasLeftComponents && (
                            <SideBar
                                side={effectiveIsBothSidebars ? "left" : undefined}
                                class={sidebarClass}
                                headings={headings}
                            />
                        )}
                    </div>
                    <div id="left-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="left-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasLeftComponents && (
                        <SideBar side="left" class={sidebarClass} headings={headings}></SideBar>
                    )}
                </div>
            )}
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div id="main-content-wrapper" class={staticBarClass}>
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main id="swup-container" class="transition-main transition-swup-fade">
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} class="hidden"></div>
                {/* 备用 h1 标题 - 提供隐藏的主标题，满足 Swup A11y 和无 h1 页面的可访问性 */}
                <h1 class="sr-only">{title || siteConfig.title}</h1>
                {/* 文章目录浮层：与参考博客一致，fixed 挂在正文右侧（不在侧栏里），
                    顶部跟随信息面板组；控制器见 src/utils/article-toc.ts */}
                {isPostPage && <SidebarTOC />}
                <div id="content-wrapper" class="onload-animation transition-leaving" data-no-sidebar={noSidebarPageType}>
                    <slot></slot>

                </div>
                <UnifiedDock headings={headings} />
            </main>
            </div>

            {/* 移动端 Dock & 菜单 Sheet — 放在 swup-container 外部，跨导航持久化 */}
            <MobileDock />
            <MobileMenuSheet />

            {/* 右侧边栏 - CSS .lg\:is-home 控制首页隐藏 */}
            {(sidebarLayoutConfig.position === "both" || sidebarLayoutConfig.position === "right") ? (
                <>
                    <div id="right-sidebar-static" class="contents">
                        {(effectiveIsBothSidebars || sidebarLayoutConfig.position === "right") && effectiveHasRightComponents && (
                            <SideBar side="right" class={rightSidebarClass} headings={headings}></SideBar>
                        )}
                    </div>
                    <div id="right-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="right-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasRightComponents && (
                        <SideBar side="right" class={rightSidebarClass} headings={headings}></SideBar>
                    )}
                </div>
            )}

            {/* 移动端底部组件 - CSS .lg\:is-home 控制首页隐藏 */}
            {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                <div id="mobile-bottom-sidebar" class="col-span-1 block md:hidden mt-4">
                    <SideBar side="bottom" class="" headings={headings}></SideBar>
                </div>
            )}

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

        <SpineModel></SpineModel>
        {live2dModelConfig.enable && <Live2DWidget config={live2dModelConfig} />}
    </div>
</div>

{commentConfig.type === 'waline' && commentConfig.waline?.visitorCount && <script type="module" is:inline define:vars={{ serverURL: commentConfig.waline.serverURL }}>
  import { pageviewCount } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';

  pageviewCount({
    serverURL,
    path: "/",
    update: true,
  });
</script>}


</Layout>

<style is:global>
  /* 右侧栏平滑过渡 */
  #right-sidebar {
    transition: opacity 0.35s ease-in-out,
                transform 0.35s ease-in-out;
  }

  @keyframes swupFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.95;
    }
  }

  /* 文章页统一布局：列间无间距，侧边栏+内容合并为整体 */
  .is-post-layout > #left-sidebar-wrapper > *,
  .is-post-layout > #left-sidebar-dynamic > *,
  .is-post-layout > #right-sidebar-static > *,
  .is-post-layout > #right-sidebar-dynamic > * {
    border-radius: 0;
  }

  .is-post-layout #content-wrapper .card-base {
    border: none !important;
  }

  /* 移动端恢复间距 */
  @media (max-width: 767px) {
    .is-post-layout {
      gap: 1rem !important;
    }
  }

</style>

<!-- 空闲预取：常点导航链接的目标页（HTML + 样式表/脚本）先暖进缓存。
     对齐 VitePress 的 prefetchLinks —— 这是「点了就来」的关键，见 src/utils/hot-prefetch.ts -->
<script>
	import { installHotPrefetch } from "@/utils/hot-prefetch";

	installHotPrefetch();
</script>
