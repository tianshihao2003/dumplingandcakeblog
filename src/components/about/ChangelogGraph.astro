---
import { getCollection } from "astro:content";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	buildChangelogLinks,
	type ChangelogType,
	changelogEntriesFromCollection,
	PAGE_META,
} from "@/utils/changelog";
import "../../styles/components/about-changelog.css";

interface Props {
	limit?: number;
}
const { limit = 30 } = Astro.props as Props;
const raw = await getCollection("changelog");
const entries = changelogEntriesFromCollection(raw);
const CHANGELOG_DISPLAY_LIMIT =
	limit > 0 ? Math.min(limit, entries.length) : entries.length;

const total = entries.length;
const visibleEntries = entries.slice(0, CHANGELOG_DISPLAY_LIMIT);
const hiddenEntryCount = total - visibleEntries.length;
const links = buildChangelogLinks(visibleEntries);
const recentLimitMessage = i18n(I18nKey.aboutChangelogRecentLimit).replace(
	"{count}",
	String(CHANGELOG_DISPLAY_LIMIT),
);

const typeLabels: Record<ChangelogType, string> = {
	feature: i18n(I18nKey.changelogFeature),
	improvement: i18n(I18nKey.changelogImprovement),
	fix: i18n(I18nKey.changelogFix),
	removal: i18n(I18nKey.changelogRemoval),
};

const pageLabels = Object.fromEntries(
	Object.entries(PAGE_META).map(([k, m]) => [k, m.label]),
);
---

<div class="changelog" data-changelog data-page-labels={JSON.stringify(pageLabels)} data-shared-prefix={i18n(I18nKey.aboutChangelogPagesLabel)}>
	<div class="changelog__heading">
		<h2 class="changelog__section-title">{i18n(I18nKey.aboutChangelogTitle)}</h2>
		{hiddenEntryCount > 0 && <span class="changelog__recent-limit">{recentLimitMessage}</span>}
	</div>

	<svg class="changelog__wires" data-changelog-wires aria-hidden="true">
		<defs>
			<marker id="changelog-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
				<path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
			</marker>
		</defs>
	</svg>

	<ol class="changelog__grid" data-changelog-grid>
		{visibleEntries.map((entry, i) => {
			const num = total - i;
			const entryLinks = links.get(i) ?? [];
			return (
				<li class="changelog-card" data-changelog-card data-index={i} data-num={num} data-type={entry.type} data-links={JSON.stringify(entryLinks.map((l) => ({ t: l.target, p: l.sharedPages })))}>
					<button type="button" class="changelog-card__inner" data-changelog-open aria-haspopup="dialog">
						<span class="changelog-card__num" aria-hidden="true">{String(num).padStart(2, "0")}</span>
						<span class="changelog-card__meta">
							<span class="changelog-card__type">{typeLabels[entry.type]}</span>
							<time class="changelog-card__date" datetime={entry.date}>{entry.date}</time>
						</span>
						<span class="changelog-card__title">{entry.title}</span>
						<span class="changelog-card__summary">{entry.summary}</span>
					</button>
					<div class="changelog-card__detail" hidden>
						<div class="changelog-card__detail-body">
							{entry.summary ? <p class="changelog-card__detail-text">{entry.summary}</p> : null}
							{entry.version ? <p class="changelog-card__detail-version">{entry.version}</p> : null}
						</div>
						<div class="changelog-card__pages">
							{entry.pages.map((page) => {
								const meta = PAGE_META[page];
								if (!meta) return <span class="changelog-card__page-chip">{page}</span>;
								return meta.url ? <a class="changelog-card__page-chip" href={meta.url}>{meta.label}</a> : <span class="changelog-card__page-chip">{meta.label}</span>;
							})}
						</div>
					</div>
				</li>
			);
		})}
	</ol>

	<div class="changelog-dialog" data-changelog-dialog hidden>
		<div class="changelog-dialog__overlay" data-changelog-close></div>
		<div class="changelog-dialog__panel" role="dialog" aria-modal="true" aria-label={i18n(I18nKey.aboutChangelogTitle)}>
			<button type="button" class="changelog-dialog__close" data-changelog-close aria-label={i18n(I18nKey.close)}>&times;</button>
			<div class="changelog-dialog__meta">
				<span class="changelog-dialog__num" data-dialog-num></span>
				<span class="changelog-dialog__type" data-dialog-type></span>
				<time class="changelog-dialog__date" data-dialog-date></time>
			</div>
			<h3 class="changelog-dialog__title" data-dialog-title></h3>
			<div class="changelog-dialog__detail" data-dialog-detail></div>
			<div class="changelog-dialog__section">
				<span class="changelog-dialog__label">{i18n(I18nKey.aboutChangelogPagesLabel)}</span>
				<div class="changelog-dialog__pages" data-dialog-pages></div>
			</div>
			<div class="changelog-dialog__section" data-dialog-related-section>
				<span class="changelog-dialog__label">{i18n(I18nKey.aboutChangelogRelatedLabel)}</span>
				<ul class="changelog-dialog__related" data-dialog-related></ul>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	function initChangelogGraph() {
		const rootEl = document.querySelector("[data-changelog]");
		if (!rootEl) return;
		const root = rootEl;
		if (root.__cleanup) root.__cleanup();
		const ac = new AbortController();
		const signal = ac.signal;
		root.__cleanup = () => ac.abort();
		const NS = "http://www.w3.org/2000/svg";
		const grid = root.querySelector("[data-changelog-grid]");
		const wiresSvg = root.querySelector("[data-changelog-wires]");
		const dialog = root.querySelector("[data-changelog-dialog]");
		if (!grid || !wiresSvg || !dialog) return;
		const pageLabels = JSON.parse(root.dataset.pageLabels || "{}");
		const sharedPrefix = root.dataset.sharedPrefix || "";
		let activeCard = null;
		const wireAnims = new Set();
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		function visibleCards() { return Array.from(grid.querySelectorAll("[data-changelog-card]")); }
		function sizeSvg() { if (wiresSvg) wiresSvg.setAttribute("viewBox", `0 0 ${root.scrollWidth} ${root.scrollHeight}`); }
		function rootRect() { return root.getBoundingClientRect(); }
		function cardCenter(card) {
			const r = card.getBoundingClientRect();
			const rr = rootRect();
			return { x: r.left - rr.left + r.width / 2, y: r.top - rr.top + r.height / 2 };
		}
		function makePath(d, cls, marker) {
			if (marker === undefined) marker = true;
			const p = document.createElementNS(NS, "path");
			p.setAttribute("d", d); p.setAttribute("class", cls);
			if (marker) p.setAttribute("marker-end", "url(#changelog-arrow)");
			return p;
		}
		function layout() {
			const cards = visibleCards();
			if (cards.length === 0) return;
			const cols = Math.max(1, getComputedStyle(grid).gridTemplateColumns.split(" ").length);
			cards.forEach((card, i) => {
				const row = Math.floor(i / cols);
				const col = i % cols;
				const visualCol = row % 2 === 0 ? col : cols - 1 - col;
				card.style.order = String(row * cols + visualCol);
			});
			drawRowArrows(cards, cols);
			clearHoverWires();
		}
		function drawRowArrows(cards, cols) {
			sizeSvg();
			wiresSvg.querySelectorAll("[data-row-arrow]").forEach((n) => n.remove());
			const rows = Math.ceil(cards.length / cols);
			const rr = rootRect();
			for (let r = 0; r < rows - 1; r++) {
				const fromCard = cards[r * cols + cols - 1];
				const toCard = cards[(r + 1) * cols];
				if (!fromCard || !toCard) continue;
				const fr = fromCard.getBoundingClientRect();
				const tr = toCard.getBoundingClientRect();
				const fy = fr.top - rr.top + fr.height / 2;
				const ty = tr.top - rr.top + tr.height / 2;
				let d;
				if (r % 2 === 0) {
					const x1 = fr.right - rr.left; const x2 = tr.right - rr.left;
					const out = Math.max(x1, x2) + 16;
					d = `M ${x2} ${ty} H ${out} V ${fy} H ${x1}`;
				} else {
					const x1 = fr.left - rr.left; const x2 = tr.left - rr.left;
					const out = Math.min(x1, x2) - 16;
					d = `M ${x2} ${ty} H ${out} V ${fy} H ${x1}`;
				}
				const path = makePath(d, "changelog-wire changelog-wire--row");
				path.setAttribute("data-row-arrow", "");
				wiresSvg.appendChild(path);
			}
		}
		function clearHoverWires() {
			for (const cancel of wireAnims) cancel();
			wireAnims.clear();
			root.querySelectorAll("[data-hover-wire]").forEach((n) => n.remove());
			root.classList.remove("is-hovering");
			root.querySelectorAll(".is-active, .is-linked").forEach((c) => c.classList.remove("is-active", "is-linked"));
		}
		function drawHoverWire(d, mid, labelText) {
			const path = makePath(d, "changelog-wire changelog-wire--hover", false);
			path.setAttribute("data-hover-wire", "");
			wiresSvg.appendChild(path);
			const label = document.createElement("span");
			label.className = "changelog-wire-label";
			label.textContent = labelText;
			label.setAttribute("data-hover-wire", "");
			label.style.left = `${mid.x}px`;
			label.style.top = `${mid.y}px`;
			root.appendChild(label);
			if (reducedMotion) {
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#changelog-arrow)");
				label.classList.add("is-in");
				return;
			}
			const len = path.getTotalLength();
			const dur = Math.min(0.75, Math.max(0.35, len / 700));
			const DASH = 6; const GAP = 5;
			const revealDash = (drawn) => {
				const segments = [];
				let used = 0; let isDash = true;
				while (used < drawn) {
					const take = Math.min(isDash ? DASH : GAP, drawn - used);
					segments.push(take); used += take; isDash = !isDash;
				}
				if (segments.length === 0) segments.push(0);
				if (segments.length % 2 === 0) segments.push(0);
				segments.push(len + DASH + GAP);
				path.style.strokeDasharray = segments.join(" ");
			};
			const arrow = document.createElementNS(NS, "polygon");
			arrow.setAttribute("points", "-8.5,-4.5 0,0 -8.5,4.5");
			arrow.setAttribute("class", "changelog-wire-arrow");
			arrow.setAttribute("data-hover-wire", "");
			wiresSvg.appendChild(arrow);
			const easeOutCubic = (t) => 1 - (1 - t) ** 3;
			const start = performance.now();
			let raf = 0;
			const cancel = () => { cancelAnimationFrame(raf); arrow.remove(); };
			wireAnims.add(cancel);
			const tick = (now) => {
				const t = Math.min(1, (now - start) / (dur * 1000));
				const drawn = len * easeOutCubic(t);
				revealDash(drawn);
				const tip = path.getPointAtLength(drawn);
				const back = path.getPointAtLength(Math.max(0, drawn - 1));
				const fwd = path.getPointAtLength(Math.min(len, drawn + 1));
				const deg = (Math.atan2(fwd.y - back.y, fwd.x - back.x) * 180) / Math.PI;
				arrow.setAttribute("transform", `translate(${tip.x} ${tip.y}) rotate(${deg})`);
				if (t < 1) { raf = requestAnimationFrame(tick); return; }
				wireAnims.delete(cancel);
				path.style.strokeDasharray = "";
				path.classList.add("is-drawn");
				path.setAttribute("marker-end", "url(#changelog-arrow)");
				arrow.remove();
				label.classList.add("is-in");
			};
			raf = requestAnimationFrame(tick);
		}
		function onCardEnter(card) {
			clearHoverWires();
			sizeSvg();
			const links = JSON.parse(card.dataset.links || "[]");
			const cardIndex = Number(card.dataset.index);
			const from = cardCenter(card);
			root.classList.add("is-hovering");
			card.classList.add("is-active");
			for (const link of links) {
				const target = root.querySelector(`[data-changelog-card][data-index="${link.t}"]`);
				if (!target) continue;
				target.classList.add("is-linked");
				const to = cardCenter(target);
				const dx = to.x - from.x; const dy = to.y - from.y;
				const len = Math.hypot(dx, dy) || 1;
				const off = Math.min(56, len * 0.12);
				const cx = (from.x + to.x) / 2 - (dy / len) * off;
				const cy = (from.y + to.y) / 2 + (dx / len) * off;
				const mid = { x: from.x * 0.25 + cx * 0.5 + to.x * 0.25, y: from.y * 0.25 + cy * 0.5 + to.y * 0.25 };
				const labelText = link.p.map((p) => pageLabels[p] || p).join("、");
				const isNewer = link.t < cardIndex;
				const start = isNewer ? from : to;
				const end = isNewer ? to : from;
				drawHoverWire(`M ${start.x} ${start.y} Q ${cx} ${cy} ${end.x} ${end.y}`, mid, labelText);
			}
		}
		function openDialog(card) {
			const q = (sel) => dialog.querySelector(sel);
			const numEl = q("[data-dialog-num]");
			if (numEl) numEl.textContent = `#${card.dataset.num}`;
			const typeEl = q("[data-dialog-type]");
			if (typeEl) { typeEl.textContent = card.querySelector(".changelog-card__type")?.textContent || ""; typeEl.dataset.type = card.dataset.type || ""; }
			const cardDate = card.querySelector(".changelog-card__date");
			const dlgDate = q("[data-dialog-date]");
			if (dlgDate) { dlgDate.textContent = cardDate?.textContent || ""; if (cardDate?.dateTime) dlgDate.dateTime = cardDate.dateTime; }
			const titleEl = q("[data-dialog-title]");
			if (titleEl) titleEl.textContent = card.querySelector(".changelog-card__title")?.textContent || "";
			const detailRoot = q("[data-dialog-detail]");
			if (detailRoot) {
				detailRoot.innerHTML = "";
				const detailText = card.querySelector(".changelog-card__detail-text")?.textContent?.trim() || "";
				if (detailText) {
					const p = document.createElement("p");
					p.className = "changelog-dialog__detail-text";
					p.textContent = detailText;
					detailRoot.appendChild(p);
				}
				const versionText = card.querySelector(".changelog-card__detail-version")?.textContent?.trim() || "";
				if (versionText) {
					const v = document.createElement("p");
					v.className = "changelog-dialog__detail-version";
					v.textContent = versionText;
					detailRoot.appendChild(v);
				}
			}
			const pagesEl = q("[data-dialog-pages]");
			if (pagesEl) pagesEl.innerHTML = card.querySelector(".changelog-card__pages")?.innerHTML || "";
			const links = JSON.parse(card.dataset.links || "[]");
			const section = q("[data-dialog-related-section]");
			const list = q("[data-dialog-related]");
			if (list) list.innerHTML = "";
			if (section) {
				if (links.length === 0) section.hidden = true;
				else {
					section.hidden = false;
					for (const link of links) {
						const target = root.querySelector(`[data-changelog-card][data-index="${link.t}"]`);
						if (!target) continue;
						const li = document.createElement("li");
						const btn = document.createElement("button");
						btn.type = "button"; btn.className = "changelog-dialog__related-btn";
						const numSpan = document.createElement("span"); numSpan.className = "changelog-dialog__related-num"; numSpan.textContent = `#${target.dataset.num}`;
						const titleSpan = document.createElement("span"); titleSpan.className = "changelog-dialog__related-title"; titleSpan.textContent = target.querySelector(".changelog-card__title")?.textContent || "";
						const pagesSpan = document.createElement("span"); pagesSpan.className = "changelog-dialog__related-pages"; pagesSpan.textContent = `${sharedPrefix}：${link.p.map((p) => pageLabels[p] || p).join("、")}`;
						btn.appendChild(numSpan); btn.appendChild(titleSpan); btn.appendChild(pagesSpan);
						btn.addEventListener("click", () => { closeDialog(); target.scrollIntoView({ behavior: "smooth", block: "center" }); target.classList.add("is-flash"); setTimeout(() => target.classList.remove("is-flash"), 1300); });
						li.appendChild(btn);
						if (list) list.appendChild(li);
					}
				}
			}
			dialog.hidden = false;
			document.documentElement.classList.add("changelog-dialog-open");
		}
		function closeDialog() { dialog.hidden = true; document.documentElement.classList.remove("changelog-dialog-open"); }
		grid.addEventListener("pointerover", (e) => {
			const t = e.target;
			if (!(t instanceof Element)) return;
			const card = t.closest("[data-changelog-card]");
			if (!card || card === activeCard) return;
			activeCard = card; onCardEnter(card);
		}, { signal });
		grid.addEventListener("pointerleave", () => { activeCard = null; clearHoverWires(); }, { signal });
		grid.addEventListener("click", (e) => {
			const t = e.target;
			if (!(t instanceof Element)) return;
			const openBtn = t.closest("[data-changelog-open]");
			if (!openBtn) return;
			const card = openBtn.closest("[data-changelog-card]");
			if (card) openDialog(card);
		}, { signal });
		dialog.querySelectorAll("[data-changelog-close]").forEach((el) => el.addEventListener("click", closeDialog, { signal }));
		document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !dialog.hidden) closeDialog(); }, { signal });
		window.addEventListener("resize", layout, { signal });
		layout();
	}
	initChangelogGraph();
	document.addEventListener("astro:page-load", initChangelogGraph);
	document.addEventListener("swup:content:replaced", initChangelogGraph);
</script>
