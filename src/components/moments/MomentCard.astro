---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getTagUrl } from "@/utils/url-utils";

interface Props {
	moment: CollectionEntry<"moments">;
}

const { moment } = Astro.props;
const { Content } = await render(moment);
const { author, avatar, published, images, tags, location, pinned } =
	moment.data;

// 获取 moments 资产目录下的所有图片
const momentAssets = import.meta.glob<{ default: ImageMetadata }>(
	"../../content/moments/assets/*.{jpeg,jpg,png,gif,webp,avif}",
	{ eager: true },
);

// 视频文件扩展名
const VIDEO_EXTENSIONS = new Set(["mp4", "webm", "mov", "ogg", "avi", "mkv"]);

const isVideoUrl = (url: string): boolean => {
	try {
		const pathname = new URL(url, "http://localhost").pathname;
		const ext = pathname.split(".").pop()?.toLowerCase() ?? "";
		return VIDEO_EXTENSIONS.has(ext);
	} catch {
		return false;
	}
};

// 解析图片路径，同时分离视频
const parseImages = (
	imagesData: (ImageMetadata | string)[] | string | undefined,
): (string | ImageMetadata)[] => {
	let rawPaths: string[] = [];
	if (Array.isArray(imagesData)) {
		rawPaths = imagesData.map((img) =>
			typeof img === "string" ? img : img.src,
		);
	} else if (typeof imagesData === "string" && imagesData.trim()) {
		rawPaths = imagesData
			.split(/[,;]/)
			.map((img) => img.trim())
			.filter((img) => img);
	}

	return Array.from(new Set(rawPaths))
		.map((img) => {
			if (
				img.startsWith("http://") ||
				img.startsWith("https://") ||
				img.startsWith("/")
			) {
				return img;
			}

			const cleanPath = img.replace(/^\.\//, "");
			if (cleanPath.startsWith("assets/")) {
				const fileName = cleanPath.replace("assets/", "");
				for (const path in momentAssets) {
					if (path.endsWith(fileName)) {
						return momentAssets[path].default;
					}
				}
			}
			return img;
		})
		.filter((img) => img);
};

// 计算图片网格列数
const getGridCols = (count: number) => {
	if (count === 1) return 1;
	if (count === 2 || count === 4) return 2;
	return 3;
};

const allMedia = parseImages(images);
const videosArray = allMedia.filter(
	(item): item is string => typeof item === "string" && isVideoUrl(item),
);
const imagesArray = allMedia.filter(
	(item) => !(typeof item === "string" && isVideoUrl(item)),
);
const gridMax = 9;

const getImgSrc = (img: string | ImageMetadata): string => {
	if (typeof img === "string") return img;
	return img.src;
};

const momentExcerpt = (moment.body || "")
	.replace(/s+/gu, " ")
	.trim()
	.slice(0, 80);
const momentPublished = moment.data.published.toISOString();

// 相对时间
const formatTimeAgo = (date: Date): string => {
	const now = new Date();
	const diff = now.getTime() - date.getTime();
	const minutes = Math.floor(diff / 60000);
	const hours = Math.floor(diff / 3600000);
	const days = Math.floor(diff / 86400000);

	if (minutes < 1) return "刚刚";
	if (minutes < 60) return `${minutes}分钟前`;
	if (hours < 24) return `${hours}小时前`;
	if (days < 30) return `${days}天前`;
	return formatDateToYYYYMMDD(date);
};
---

<div id={moment.id} class="moment-card group">
		<div class="card-accent-bar"></div>
	<!-- 卡片头部：头像 + 用户信息 -->
	<div class="card-header">
		<div class="card-avatar">
			{avatar ? (
				<img
					src={avatar}
					alt={author}
					class="avatar-img"
					loading="lazy"
				/>
			) : (
				<img
					src="/avatar.png"
					alt={author}
					class="avatar-img"
					loading="lazy"
					onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%23999%22><circle cx=%2212%22 cy=%228%22 r=%224%22/><path d=%22M20 21a8 8 0 1 0-16 0%22/></svg>'"
				/>
			)}
		</div>
		<div class="card-user-info">
			<div class="user-row">
				<span class="user-name">{author || "匿名"}</span>
				{pinned && (
					<span class="pinned-badge">
						<Icon name="material-symbols:pinboard" class="pinned-icon" />
						<span>置顶</span>
					</span>
				)}
			</div>
			<div class="meta-row">
				<time
					datetime={published.toISOString()}
					title={formatDateToYYYYMMDD(published)}
				>
					{formatTimeAgo(published)}
				</time>
				{location && (
					<>
						<span class="meta-dot">·</span>
						<span class="location">
							<Icon
								name="material-symbols:location-on-outline"
								class="location-icon"
							/>
							{location}
						</span>
					</>
				)}
			</div>
		</div>
	</div>

	<!-- 内容 -->
	<div class="card-content">
		<div
			class="moment-markdown text-[var(--text-color)] text-[0.9375rem] leading-[1.75]"
		>
			<Markdown class="moment-markdown-content">
				<Content />
			</Markdown>
		</div>
	</div>

	<!-- 视频 -->
	{videosArray && videosArray.length > 0 && (
		<div class="card-images image-cols-1">
			{videosArray.map((videoUrl) => (
				<a
					class="image-item video-thumb"
					href={videoUrl}
					target="_blank"
					rel="noopener"
					aria-label="播放视频"
				>
					<video
						class="image-img"
						src={videoUrl}
						preload="metadata"
						playsinline
						muted
					></video>
					<div class="video-play-overlay">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="white" aria-hidden="true">
							<path d="M8 5v14l11-7z"/>
						</svg>
					</div>
				</a>
			))}
		</div>
	)}

	<!-- 图片 -->
	{imagesArray && imagesArray.length > 0 && (
		<div
			class={`card-images image-cols-${getGridCols(imagesArray.length)} `}
		>
			{imagesArray.map((img, index) => {
				const imgSrc = getImgSrc(img);
				const isHidden = index >= gridMax;
				const isLastVisible = index === gridMax - 1 && imagesArray.length > gridMax;

				return (
					<div class={`image-item ${isHidden ? "hidden-image" : ""}`}>
						{typeof img === "string" ? (
							<img
								src={img}
								alt="Moment image"
								class="image-img"
								loading="lazy"
								data-fancybox={`gallery-${moment.id}`}
								data-src={imgSrc}
							/>
						) : (
							<Image
								src={img}
								alt="Moment image"
								class="image-img"
								loading="lazy"
								data-fancybox={`gallery-${moment.id}`}
								data-src={imgSrc}
							/>
						)}

						{isLastVisible && (
							<div class="more-overlay">
								<span class="more-text">+{imagesArray.length - gridMax + 1}</span>
							</div>
						)}
					</div>
				);
			})}
		</div>
	)}

	<!-- 底部：标签 + 评论按钮 -->
	<div class="card-bottom-row">
		{tags && tags.length > 0 && (
			<div class="card-tags">
				{tags.map((tag) => (
					<a href={getTagUrl(tag)} class="tag-item">
						#{tag.trim()}
					</a>
				))}
			</div>
		)}
			<div class="card-comment-toggle">
			<button
				class="comment-toggle-btn"
				data-moment-id={moment.id}
				data-moment-published={momentPublished}
				data-moment-excerpt={momentExcerpt}
				aria-label="评论"
				type="button"
			>
				<Icon name="material-symbols:chat-bubble-outline" class="comment-toggle-icon" />
				<span class="comment-toggle-text">评论</span>
			</button>
		</div>
	</div>
</div>

<style>
	@reference "../../styles/main.css";

	/* ============================================
	 * 卡片主体
	 * ============================================ */
	.moment-card {
		position: relative;
		background: var(--card-bg);
		border-radius: 0.75rem;
		padding: 1.25rem 1.25rem 1.25rem 2.25rem;
		border: 1px solid oklch(0.25 0 0);
		overflow: hidden;
		transition:
			box-shadow 0.25s ease,
			transform 0.25s ease,
			border-color 0.25s ease;
	}

	:root.dark .moment-card {
		border-color: oklch(0.85 0 0);
	}

	.card-accent-bar {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 4px;
		background: var(--primary);
		opacity: 0.35;
		border-radius: 0 2px 2px 0;
	}

	.moment-card:hover {
		border-color: var(--primary);
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
		transform: translateY(-2px);
	}

	:root.dark .moment-card:hover {
		border-color: #fff;
		box-shadow: 0 4px 24px rgba(255, 255, 255, 0.08);
	}

	/* ============================================
	 * 卡片头部
	 * ============================================ */
	.card-header {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.75rem;
	}

	/* 头像 */
	.card-avatar {
		flex-shrink: 0;
	}

	.avatar-img {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--primary);
		box-sizing: border-box;
	}

	.card-user-info {
		flex: 1;
		min-width: 0;
	}

	.user-row {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-bottom: 0.125rem;
	}

	.user-name {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--primary);
	}

	.pinned-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.125rem 0.5rem;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		border-radius: var(--radius);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.pinned-icon {
		font-size: 0.875rem;
	}

	.meta-row {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.75rem;
		color: var(--content-meta);
	}

	.meta-dot {
		opacity: 0.5;
	}

	.location {
		display: inline-flex;
		align-items: center;
		gap: 0.125rem;
		max-width: 120px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.location-icon {
		font-size: 0.875rem;
		flex-shrink: 0;
	}

	/* ============================================
	 * 内容区域
	 * ============================================ */
	.card-content {
		margin-bottom: 0.75rem;
	}

	.moment-markdown :global(p) {
		margin-bottom: 0.375rem;
		word-break: break-word;
	}

	.moment-markdown :global(p:last-child) {
		margin-bottom: 0;
	}

	.moment-markdown :global(img) {
		border-radius: var(--radius);
		margin: 0.5rem 0;
		max-width: 100%;
	}

	/* ============================================
	 * 视频缩略图
	 * ============================================ */
	.video-thumb {
		position: relative;
		aspect-ratio: 16 / 9;
	}

	.video-play-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.25);
		opacity: 0.9;
		transition: opacity 0.2s ease;
	}

	.video-thumb:hover .video-play-overlay {
		opacity: 1;
	}

	/* ============================================
	 * 图片网格
	 * ============================================ */
	.card-images {
		display: grid;
		gap: 0.375rem;
		margin-bottom: 0.75rem;
	}

	.image-cols-1 {
		grid-template-columns: 100px;
	}

	.image-cols-2 {
		grid-template-columns: repeat(2, 100px);
	}

	.image-cols-3 {
		grid-template-columns: repeat(3, 90px);
	}

	.image-item {
		position: relative;
		border-radius: var(--radius);
		overflow: hidden;
		cursor: pointer;
		background: var(--bg-secondary);
		aspect-ratio: 1;
	}

	
	.image-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.image-item:hover .image-img {
		transform: scale(1.03);
	}

	.hidden-image { display: none !important; }
.has-more .image-img {
		filter: brightness(0.6);
	}

	.more-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.more-text {
		font-size: 1.5rem;
		font-weight: 700;
		color: white;
		text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
	}

	/* ============================================
	 * 底部行：标签 + 评论按钮
	 * ============================================ */
	.card-bottom-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.tag-item {
		padding: 0.25rem 0.625rem;
		background: transparent;
		border: 1px solid var(--primary);
		border-radius: 9999px;
		font-size: 0.75rem;
		color: var(--primary);
		transition: all 0.2s ease;
	}

	.tag-item:hover {
		background: color-mix(in srgb, var(--primary) 10%, transparent);
	}

	/* ============================================
	 * 响应式
	 * ============================================ */
	@media (max-width: 480px) {
		.moment-card {
			padding: 0.875rem;
			border-radius: 0.625rem;
		}

		.avatar-img {
			width: 2.25rem;
			height: 2.25rem;
		}

		.user-name {
			font-size: 0.875rem;
		}

		.meta-row {
			font-size: 0.6875rem;
		}

		.location {
			max-width: 80px;
		}

		.card-images {
			gap: 0.25rem;
		}

		.more-text {
			font-size: 1.25rem;
		}
	}

	/* ============================================
	 * 评论按钮
	 * ============================================ */
	.card-comment-toggle {
		display: flex;
		flex-shrink: 0;
	}

	.comment-toggle-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.75rem;
		border: 1.5px solid var(--line-color);
		border-radius: 9999px;
		background: transparent;
		color: var(--content-meta);
		font-size: 0.75rem;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.comment-toggle-btn:hover {
		border-color: var(--primary);
		color: var(--primary);
	}

	.comment-toggle-btn.is-active {
		border-color: var(--primary);
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 8%, transparent);
	}

	.comment-toggle-icon {
		width: 1rem;
		height: 1rem;
	}
</style>
